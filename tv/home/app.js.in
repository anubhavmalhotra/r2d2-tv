  }
  function browserIcon() {
    var ns = "http://www.w3.org/2000/svg", svg = document.createElementNS(ns,"svg");
    svg.setAttribute("viewBox","0 0 96 72"); svg.setAttribute("class","icon-browser"); svg.setAttribute("aria-hidden","true"); svg.setAttribute("focusable","false");
    function shape(tag, attrs) { var el = document.createElementNS(ns,tag); Object.keys(attrs).forEach(function (key) { el.setAttribute(key,attrs[key]); }); svg.appendChild(el); }
