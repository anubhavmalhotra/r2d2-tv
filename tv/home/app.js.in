    if (panel && $("panel-content").contains(el)) el.scrollIntoView({block:"nearest",inline:"nearest"});
  }
  function firstDock() { return $("dock").querySelector("button:not(:disabled)") || $("search-open"); }
  function move(direction) {
    var candidates = focusables(), current = document.activeElement;
    if (candidates.indexOf(current) < 0) { focus(panel ? $("panel-close") : firstDock()); return; }
    var box = current.getBoundingClientRect(), x = box.left + box.width / 2, y = box.top + box.height / 2;
    var best = null, score = Infinity;
    candidates.forEach(function (candidate) {
      if (candidate === current) return;
      var b = candidate.getBoundingClientRect(), dx = b.left + b.width / 2 - x, dy = b.top + b.height / 2 - y;
      var horizontal = direction === "left" || direction === "right";
      var axis = direction === "left" ? -dx : direction === "right" ? dx : direction === "up" ? -dy : dy;
      var cross = horizontal ? Math.abs(dy) : Math.abs(dx);
      if (axis < 2) return;
      if (horizontal && cross > Math.max(box.height, b.height) * 0.65) return;
      var value = axis + cross * 3;
      if (value < score) { score = value; best = candidate; }
    });
