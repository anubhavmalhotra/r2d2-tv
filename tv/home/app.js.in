    shape("rect",{x:9,y:9,width:78,height:54,rx:10,fill:"#e7eef5"});
    shape("path",{d:"M19 9h58a10 10 0 0 1 10 10v7H9v-7A10 10 0 0 1 19 9Z",fill:"#2867c1"});
    [19,27,35].forEach(function (x) { shape("circle",{cx:x,cy:18,r:2,fill:"#cfebff"}); });
    shape("path",{d:"M48 37v-5",stroke:"#34464d","stroke-width":2,"stroke-linecap":"round"});
    shape("circle",{cx:48,cy:31,r:2.5,fill:"#ee866a"});
    shape("circle",{cx:25,cy:49,r:3.5,fill:"#34464d"}); shape("circle",{cx:71,cy:49,r:3.5,fill:"#34464d"});
    shape("rect",{x:26,y:37,width:44,height:26,rx:9,fill:"#f3efe6",stroke:"#8f8676","stroke-width":1.5});
    shape("rect",{x:31,y:41,width:34,height:17,rx:6,fill:"#0f1b24"});
    shape("rect",{x:39,y:44,width:5,height:8,rx:2.5,fill:"#83ecff"}); shape("rect",{x:52,y:44,width:5,height:8,rx:2.5,fill:"#83ecff"});
    return svg;
  }
  function gridIcon() { var el = document.createElement("span"); el.className = "icon-grid"; el.setAttribute("aria-hidden","true"); for (var i=0;i<9;i++) el.appendChild(document.createElement("i")); return el; }
  // Logos are an optional private build input; without one a brand shows its text mark.
  function logoFor(brand) { var logo = brand && catalog.logos.hasOwnProperty(brand.id) && catalog.logos[brand.id]; return typeof logo === "string" ? logo : null; }
  function brandImage(brand, extraClass) {
    var image = document.createElement("img"); image.className = "brand-image " + (extraClass || ""); image.src = logoFor(brand); image.alt = ""; image.setAttribute("aria-hidden","true"); return image;
  }
  function fitLine(el) {
    // text-overflow:ellipsis draws U+2026, which the TV's fallback font sets mid-line, so
    // cut an overflowing one-line label here and end it with three periods instead.
    var full = el.textContent, low = 0, high = full.length;
    if (!full || el.scrollWidth <= el.clientWidth) return;
    while (low < high) {
      var mid = Math.ceil((low + high) / 2);
      el.textContent = full.slice(0, mid).replace(/\s+$/, "") + "...";
      if (el.scrollWidth <= el.clientWidth) low = mid; else high = mid - 1;
    }
    el.textContent = full.slice(0, low).replace(/\s+$/, "") + "...";
  }
  function browserLabel() { return {idle:"Available",ready:"Available",starting:"Starting...",stopping:"Finishing...",error:"Unavailable",offline:"Spark offline",unavailable:"Unavailable",checking:"Checking..."}[browserState]; }
  function renderBrowser() {
    var button = $("chromium-browser");
    if (button) {
      button.setAttribute("aria-label", "R2D2 Browser — " + browserLabel());
      button.setAttribute("aria-busy", String(browserChecking || browserState === "starting"));
      button.querySelector(".browser-status").textContent = browserLabel();
    }
    if (!chromiumSelected) return;
    $("hero-brand").textContent = "R2D2 BROWSER";
    $("hero-kicker").textContent = "POWERED BY CHROMIUM";
    $("hero-title").textContent = "A browser.\nOn your terms.";
    $("hero-description").textContent = {unavailable:"Your Spark browser connection is not available yet.",offline:"Spark is not responding. Try again when it is available.",error:"The browser is unavailable right now. Please try again.",checking:"Checking your Spark browser connection...",stopping:"Your private session is finishing. Try again in a moment."}[browserState] || "Open a private browser session on Spark, here on your TV.";
    fitLine($("hero-description")); $("hero-tags").replaceChildren(); voiceHint("chromium-browser");
    ["Private session",browserLabel()].forEach(function (text) { var tag = document.createElement("span"); tag.textContent = text; $("hero-tags").appendChild(tag); });
  }
  function checkBrowser() {
    if (browserChecking) return;
    var generation = ++browserGeneration; browserChecking = true; browserState = "checking"; renderBrowser();
    service.browserStatus().then(function (state) {
      if (generation !== browserGeneration) return;
      browserChecking = false; browserState = state; renderBrowser();
    });
  }
  function selectChromium() { chromiumSelected = true; selectedId = null; renderBrowser(); checkBrowser(); }
  function openBrowser() {
    chromiumSelected = true; selectedId = null;
    if (busy) return;
    if (!service.browserAvailable()) { browserState = "unavailable"; renderBrowser(); notice("The Spark browser connection is unavailable."); return; }
    busy = true; browserChecking = false; ++browserGeneration; browserState = "starting"; renderBrowser(); notice("Opening R2D2 Browser...");
    service.launchBrowser().then(function () { busy = false; renderBrowser(); }, function () { busy = false; browserState = "error"; renderBrowser(); notice("R2D2 Browser could not open. Please try again."); });
  }
  function chromiumTile() {
    var button = document.createElement("button"), tile = document.createElement("span"), label = document.createElement("span");
    button.className = "dock-button chromium-browser"; button.id = "chromium-browser"; button.dataset.navrow = "dock"; button.title = "R2D2 Browser";
    button.setAttribute("aria-label", "R2D2 Browser — " + browserLabel());
    tile.className = "tile"; tile.appendChild(browserIcon());
    var status = document.createElement("span"); status.className = "browser-status"; status.textContent = browserLabel(); tile.appendChild(status);
    label.className = "dock-label"; label.textContent = "R2D2 Browser"; button.appendChild(tile); button.appendChild(label);
    button.addEventListener("focus", selectChromium); button.addEventListener("mouseenter", selectChromium);
    button.addEventListener("click", openBrowser);
    return button;
  }
  function selectHero(id) {
    var app = appById(id), brand = brandById(id);
    if (!app || !brand) return;
    chromiumSelected = false; selectedId = id;
    $("hero-brand").textContent = brand.title.toUpperCase();
    $("hero-kicker").textContent = "PICK YOUR NEXT ESCAPE";
    $("hero-title").textContent = brand.headline;
    $("hero-description").textContent = brand.description; fitLine($("hero-description"));
    $("hero-tags").replaceChildren(); voiceHint(id);
    [brand.tag || "Movies & series"].forEach(function (label) { var el = document.createElement("span"); el.textContent = label; $("hero-tags").appendChild(el); });
  }
  function launch(id) {
    if (busy) return;
    var app = appById(id);
    if (!app) { notice("Refresh your apps before opening this item."); return; }
    busy = true; notice("Opening " + titleFor(app) + "...");
    service.launch(id).then(function () { busy = false; }, function (error) { busy = false; notice(error.message); });
  }
  function appButton(app, inDock) {
    var brand = brandById(app.id), button = document.createElement("button"), tile = document.createElement("span"), label = document.createElement("span");
    button.className = "dock-button " + (brand ? brand.tone : "utility"); button.dataset.appId = app.id;
    button.setAttribute("aria-label", "Open " + titleFor(app));
    tile.className = "tile"; label.className = "dock-label"; label.textContent = titleFor(app);
    if (logoFor(brand)) tile.appendChild(brandImage(brand));
    else tile.textContent = brand ? brand.mark : titleFor(app);
    button.appendChild(tile); button.appendChild(label);
    button.addEventListener("click", function () { launch(app.id); });
    if (inDock) { button.dataset.navrow = "dock"; button.addEventListener("focus", function () { selectHero(app.id); }); button.addEventListener("mouseenter", function () { selectHero(app.id); }); }
    return button;
  }
  function renderHome() {
    $("dock").replaceChildren();
    var shownApps = Object.create(null);
    function append(id) {
      if (id === null) { $("dock").appendChild(chromiumTile()); return; }
      var app = appById(id);
      if (app && app.visible && !shownApps[id]) {
        shownApps[id] = true;
        $("dock").appendChild(appButton(app,true));
      }
    }
    // One collection: favorites first, then every remaining installed app once.
    dockIds.forEach(append);
    catalog.library.forEach(append);
    var all = document.createElement("button"), tile = document.createElement("span"), label = document.createElement("span");
    all.className = "dock-button utility"; all.dataset.navrow = "dock"; all.id = "all-apps"; all.setAttribute("aria-label","All apps"); tile.className = "tile"; tile.appendChild(gridIcon()); label.className = "dock-label"; label.textContent = "All apps"; all.appendChild(tile); all.appendChild(label); all.addEventListener("click", function () { openPanel("apps"); }); $("dock").appendChild(all);
    Array.prototype.forEach.call($("dock").querySelectorAll(".dock-label"), fitLine);
    var selected = appById(selectedId) || apps.find(function (app) { return app.visible && brandById(app.id); });
    if (chromiumSelected) renderBrowser();
    else if (selected) selectHero(selected.id);
    else { selectedId = null; $("hero-brand").textContent = "R2D2"; $("hero-kicker").textContent = "PICK YOUR NEXT ESCAPE"; $("hero-title").textContent = "Your apps.\nYour space."; $("hero-description").textContent = "Everything you love, a little closer."; fitLine($("hero-description")); $("hero-tags").replaceChildren(); }
  }
  function visibleApps() { return apps.filter(function (app) { return app.visible; }); }
  function renderPanelApps(query) {
    $("panel-content").replaceChildren();
    var normalized = (query || "").trim().toLowerCase();
    var list = visibleApps().filter(function (app) { return (titleFor(app) + " " + app.title).toLowerCase().indexOf(normalized) !== -1; });
    list.forEach(function (app) { $("panel-content").appendChild(appButton(app,false)); });
    Array.prototype.forEach.call($("panel-content").querySelectorAll(".dock-label"), fitLine);
    $("panel-empty").textContent = normalized ? "No apps found. Try another name." : "Your apps will appear here after a refresh."; $("panel-empty").hidden = list.length > 0;
  }
  function textBlock(paragraphs) {
    var block = document.createElement("div"); block.className = "text-panel";
    paragraphs.forEach(function (text) { var p = document.createElement("p"); p.textContent = text; block.appendChild(p); });
    $("panel-content").appendChild(block); return block;
  }
  function localButton(label, action, pressed) { var button = document.createElement("button"); button.className = "secondary-button"; button.textContent = label; if (typeof pressed === "boolean") button.setAttribute("aria-pressed",String(pressed)); button.addEventListener("click",action); return button; }
  function removable(app) {
    return app && app.visible && app.removable === true && app.systemApp === false && catalog.library.indexOf(app.id) !== -1 && app.id !== catalog.appId && app.id !== "com.webos.app.tinybrowser";
  }
  function showPanelError(message) { $("panel-feedback").textContent = message; $("panel-feedback").hidden = false; }
  function renderManage() {
    $("panel-content").replaceChildren();
    visibleApps().forEach(function (app) {
      var row = document.createElement("div"), icon = document.createElement("span"), copy = document.createElement("span"), title = document.createElement("strong"), detail = document.createElement("span"), brand = brandById(app.id);
      row.className = "manage-row"; row.dataset.manageId = app.id; icon.className = "manage-icon " + (brand ? brand.tone : "utility");
      if (logoFor(brand)) icon.appendChild(brandImage(brand));
      else if (brand) { icon.classList.add("manage-mark"); icon.textContent = brand.mark; }
      copy.className = "manage-copy"; title.textContent = titleFor(app); detail.textContent = removable(app) ? "Installed app" : "Protected app"; copy.appendChild(title); copy.appendChild(detail); row.appendChild(icon); row.appendChild(copy);
      if (removable(app)) {
        var button = localButton("Delete",function () {
          if (removalPending || busy) return;
          deleteCandidate = {id:app.id,title:titleFor(app)}; manageFocusId = app.id; openPanel("confirm-delete");
        });
        button.classList.add("delete-button"); button.disabled = removalPending; button.dataset.deleteId = app.id; button.setAttribute("aria-label","Delete " + titleFor(app)); row.appendChild(button);
      } else { var label = document.createElement("span"); label.className = "protected-label"; label.textContent = "Protected"; row.appendChild(label); }
      $("panel-content").appendChild(row);
    });
    var browser = document.createElement("div"); browser.className = "manage-row";
    var icon = document.createElement("span"); icon.className = "manage-icon browser-icon"; icon.appendChild(browserIcon()); browser.appendChild(icon);
    var copy = document.createElement("span"); copy.className = "manage-copy";
    var title = document.createElement("strong"); title.textContent = "R2D2 Browser"; copy.appendChild(title);
    var detail = document.createElement("span"); detail.textContent = "Part of R2D2"; copy.appendChild(detail); browser.appendChild(copy);
    var protectedLabel = document.createElement("span"); protectedLabel.className = "protected-label"; protectedLabel.textContent = "Protected"; browser.appendChild(protectedLabel); $("panel-content").appendChild(browser);
  }
  function cancelDelete() {
    deleteCandidate = null; openPanel("manage");
    var previous = Array.prototype.find.call($("panel-content").querySelectorAll("[data-delete-id]"),function (button) { return button.dataset.deleteId === manageFocusId; });
    focus(previous && !previous.disabled ? previous : $("panel-content").querySelector("button:not(:disabled)") || $("panel-close"));
  }
  function confirmDelete() {
    if (!deleteCandidate || removalPending || busy) return;
    var candidate = deleteCandidate, app = appById(candidate.id);
    if (!removable(app) || typeof service.removeApp !== "function") { showPanelError("This app cannot be deleted from R2D2."); return; }
    var generation = ++removalGeneration; removalPending = true; busy = true;
    $("delete-confirm").disabled = true; $("delete-confirm").textContent = "Deleting..."; $("delete-cancel").textContent = "Back to apps"; $("panel-close").setAttribute("aria-label","Back to app list"); $("panel-feedback").hidden = true;
    Promise.resolve().then(function () { if (generation !== removalGeneration) throw new Error("Deletion was interrupted. Refresh your apps to check its result."); return service.removeApp(candidate.id); }).then(function () {
      if (generation !== removalGeneration) return;
      removalPending = false; busy = false; deleteCandidate = null;
