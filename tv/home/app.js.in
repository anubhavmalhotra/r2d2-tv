        $("delete-confirm").disabled = true; $("delete-confirm").textContent = "Delete app"; $("delete-cancel").textContent = "Cancel"; $("delete-refresh").hidden = false; showPanelError(message); focus($("delete-cancel"));
      } else notice(message);
    });
  }
  function openStore() {
    if (busy || removalPending) { notice("Please wait for the current app action to finish."); return; }
    if (typeof service.openStore !== "function") { notice("The App Store is unavailable on this TV."); return; }
    busy = true;
    Promise.resolve().then(function () { return service.openStore(); }).then(function () { busy = false; },function (error) { busy = false; notice(error && error.message ? error.message : "The App Store could not open. Please try again."); });
  }
  function openPanel(next) {
    if (!panel) lastFocus = document.activeElement;
    panel = next; $("overlay").hidden = false; $("panel").setAttribute("role",next === "confirm-delete" ? "alertdialog" : "dialog"); $("panel-feedback").hidden = true; $("panel-close").setAttribute("aria-label",next === "confirm-delete" ? "Cancel deletion" : "Close"); $("panel-content").replaceChildren(); $("panel-content").scrollTop = 0; $("panel-empty").hidden = true; $("search-wrap").hidden = next !== "search";
    $("panel-title").textContent = {apps:"All apps",search:"Find your app",inputs:"Inputs & AirPlay",preferences:"Home preferences",profile:"Remote & help","voice-help":"Voice commands",manage:"Manage apps","confirm-delete":"Delete " + (deleteCandidate ? deleteCandidate.title : "app") + "?"}[next];
    $("panel-description").textContent = {apps:"Everything you watch, all together.",search:"A little less looking. A little more watching.",inputs:"Connect a screen, or choose an HDMI input.",preferences:"A few things to make yourself at home.",profile:"Everything you need, close at hand.","voice-help":"Hold the mic button on your remote, say one short command, then let go.",manage:removalPending ? "An app is being deleted. You can return to Home while it finishes." : "Delete apps you no longer use. R2D2 and system features stay protected.","confirm-delete":"The app and its saved data may be removed from this TV. You may need to sign in again if you reinstall it."}[next];
    if (next === "apps" || next === "search") { $("search-input").value = ""; renderPanelApps(""); }
    if (next === "inputs") {
      catalog.shortcuts.filter(function (item) { return (item.kind === "input" || item.kind === "feature") && appById(item.id); }).forEach(function (item) {
        var button = appButton({id:item.id,title:item.title},false); button.querySelector(".tile").textContent = item.symbol; button.querySelector(".tile").classList.add("utility-tile"); $("panel-content").appendChild(button);
      });
      $("panel-empty").textContent = "No inputs are available right now."; $("panel-empty").hidden = $("panel-content").children.length > 0;
    }
    if (next === "manage") renderManage();
    if (next === "confirm-delete") {
      var confirmation = textBlock(["Reinstalling later depends on the app’s availability in the App Store."]), actions = document.createElement("div"); actions.className = "inline-actions";
      var cancel = localButton(removalPending ? "Back to apps" : "Cancel",cancelDelete); cancel.id = "delete-cancel"; actions.appendChild(cancel);
      var confirm = localButton(removalPending ? "Deleting..." : "Delete app",confirmDelete); confirm.id = "delete-confirm"; confirm.classList.add("danger-button"); confirm.disabled = removalPending; actions.appendChild(confirm);
      var refreshList = localButton("Refresh app list",function () { deleteCandidate = null; openPanel("manage"); refresh(); }); refreshList.id = "delete-refresh"; refreshList.hidden = true; actions.appendChild(refreshList); confirmation.appendChild(actions);
    }
    if (next === "preferences") {
      var block = textBlock(["Choose how Home looks, manage your apps, or find something new in the App Store."]), actions = document.createElement("div"); actions.className = "inline-actions";
      var calm = document.body.classList.contains("calm");
      var toggle = localButton(calm ? "Soft colors · On" : "Soft colors · Off", function () {
        var enabled = !document.body.classList.contains("calm"); document.body.classList.toggle("calm",enabled); toggle.textContent = enabled ? "Soft colors · On" : "Soft colors · Off"; toggle.setAttribute("aria-pressed",String(enabled));
        try { localStorage.setItem("baaz.calm.v1",String(enabled)); } catch (_) { notice("Colors changed for this visit."); }
      },calm);
      var manage = localButton("Manage apps",function () { openPanel("manage"); }); manage.id = "manage-apps"; actions.appendChild(manage);
      var store = localButton("App Store",openStore); store.id = "app-store"; actions.appendChild(store);
      actions.appendChild(toggle); actions.appendChild(localButton("Refresh apps",function () { closePanel(); refresh(); })); actions.appendChild(localButton("Restart TV",function () { closePanel(); if (busy) return; if (!service.browserAvailable() || typeof service.restartTv !== "function") { notice("The Spark connection is unavailable."); return; } busy = true; notice("Restarting TV..."); service.restartTv().then(function () { busy = false; }, function () { busy = false; notice("TV could not restart. Please try again."); }); })); block.appendChild(actions);
    }
    if (next === "profile") {
      var help = textBlock(["Point and click, or use the arrows and OK to open an app. Press Back to close a panel and return to your apps.","Find an app with Search. Open Inputs & AirPlay to share a screen or switch to a connected device. Refresh your app list in Home preferences."]);
      if (voiceFeed.available()) { var helpActions = document.createElement("div"), voiceHelp = localButton("Voice commands",function () { openPanel("voice-help"); }); helpActions.className = "inline-actions"; voiceHelp.id = "voice-help-open"; helpActions.appendChild(voiceHelp); help.appendChild(helpActions); }
    }
    if (next === "voice-help") renderVoiceHelp();
    focus(next === "search" ? $("search-input") : next === "confirm-delete" ? $("delete-cancel") : $("panel-content").querySelector("button:not(:disabled)") || $("panel-close"));
    renderVoice();
  }
  function closePanel() { panel = null; deleteCandidate = null; $("overlay").hidden = true; focus(lastFocus && lastFocus.isConnected ? lastFocus : firstDock()); renderVoice(); }
  function back() { if (panel === "confirm-delete") cancelDelete(); else if (panel === "manage") { openPanel("preferences"); focus($("manage-apps")); } else if (panel === "voice-help") { openPanel("profile"); focus($("voice-help-open")); } else if (panel) closePanel(); else focus(firstDock()); }
  function refresh(removed) {
    if (removalPending) { notice("Please wait for app deletion to finish before refreshing."); return; }
    var sequence = ++refreshSequence; ++browserGeneration; browserChecking = false; browserState = "checking"; inventoryReady = false; service.cancelAll(); busy = false; apps = []; selectedId = null; renderHome(); $("status").textContent = "Getting your apps..."; $("status").classList.remove("error");
    if (panel === "manage") { $("panel-content").replaceChildren(); textBlock(["Refreshing your apps..."]); focus($("panel-close")); }
    service.refresh(catalog).then(function (result) {
      if (sequence !== refreshSequence) return;
      apps = result; inventoryReady = true; renderHome(); checkBrowser(); $("status").textContent = visibleApps().length ? "" : "No apps returned. Use Home preferences to refresh."; if (panel === "apps" || panel === "search") renderPanelApps($("search-input").value); else if (panel === "manage") { renderManage(); focus($("panel-content").querySelector("button:not(:disabled)") || $("panel-close")); } else if (!panel) focus(firstDock());
      if (removed) notice(appById(removed.removedId) ? "The TV still lists " + removed.title + ". Refresh apps again in a moment." : removed.title + " deleted.");
    },function (error) {
      if (sequence !== refreshSequence) return;
      apps = []; browserState = "unavailable"; renderHome(); renderBrowser(); $("status").textContent = error.message; $("status").classList.add("error"); if (panel === "manage") { $("panel-content").replaceChildren(); textBlock([error.message]); focus($("panel-close")); } if (removed) notice("Delete request accepted, but the app list could not refresh. " + error.message); if (!panel) focus($("preferences-open"));
    });
