(function () {
  "use strict";
  var catalog = window.OwnerCatalog;
  var service = new window.OwnerCore.Service(window.webOSServiceBridge || window.PalmServiceBridge, 7000, catalog.browser);
  var chromiumSelected = false, browserState = "checking", browserChecking = false, browserGeneration = 0, inventoryReady = false;
  var apps = [], selectedId = null, panel = null, busy = false, refreshSequence = 0, toastTimer, lastFocus = null;
  var deleteCandidate = null, removalPending = false, removalInterrupted = false, removalGeneration = 0, manageFocusId = null, pulseButton, pulseTimer;
  var $ = function (id) { return document.getElementById(id); };
  var dockIds = ["netflix", "com.apple.appletv", "com.tubitv.ott.tubi", null, "youtube.leanback.v4", "amazon", "com.disney.disneyplus-prod"];
  function appById(id) { return apps.find(function (app) { return app.id === id; }); }
  function brandById(id) { return catalog.favorites.find(function (app) { return app.id === id; }); }
  function titleFor(app) { var brand = brandById(app.id); return brand ? brand.title : app.title; }
  function resize() { document.documentElement.style.setProperty("--scale", String(Math.min(window.innerWidth / 1920, window.innerHeight / 1080))); }
  resize(); window.addEventListener("resize", resize);
  try { document.body.classList.toggle("calm", localStorage.getItem("baaz.calm.v1") === "true"); } catch (_) {}

  function notice(message) { clearTimeout(toastTimer); $("toast").textContent = message; $("toast").hidden = false; toastTimer = setTimeout(function () { $("toast").hidden = true; }, 3800); }
  function focusables() {
    var scope = panel ? $("overlay") : $("screen");
    return Array.prototype.filter.call(scope.querySelectorAll("button:not(:disabled), input:not(:disabled)"), function (el) { return el.getClientRects().length > 0; });
  }
  function focus(el) {
    if (!el || el.disabled) return;
    if (panel && !$("overlay").contains(el)) el = $("panel-close");
