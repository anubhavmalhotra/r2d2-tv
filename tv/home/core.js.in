    var d = date instanceof Date ? date : new Date(date !== undefined ? date : Date.now());
    var catalogSports = catalog && Array.isArray(catalog.sports) ? catalog.sports : [];
    var librarySet = Object.create(null), byAppId = Object.create(null), brandById = Object.create(null);
    if (catalog && Array.isArray(catalog.library)) catalog.library.forEach(function (id) { librarySet[id] = true; });
    if (catalog && Array.isArray(catalog.favorites)) catalog.favorites.forEach(function (b) { if (b && b.id) brandById[b.id] = b; });
    (Array.isArray(apps) ? apps : []).forEach(function (a) { if (a && a.visible && typeof a.id === "string") byAppId[a.id] = a; });

    var byAppFollowed = Object.create(null), appOrder = [];
    var evaluatedSports = catalogSports.map(function (sport) {
      var inSeason = isSportInSeason(sport, d);
      var cycleKey = sportCycleKey(sport, d, inSeason);
      var followed = state.followed.indexOf(sport.id) !== -1;
      var installed = byAppId[sport.appId] || null;
      var removable = !!(installed && installed.removable === true && installed.systemApp === false && librarySet[sport.appId] && sport.appId !== catalog.appId && sport.appId !== BROWSER_APP);
      var brand = brandById[sport.appId] || {id: sport.appId, title: sport.appId, mark: sport.appId, tone: "utility"};
      var entry = {
        id: sport.id, title: sport.title, name: sport.name || sport.title, mark: sport.mark || sport.title,
        appId: sport.appId, appTitle: brand.title, appMark: brand.mark, appTone: brand.tone,
        startMonth: sport.startMonth, endMonth: sport.endMonth, season: sport.season, endMonthName: sport.endMonthName,
        headline: sport.headline, reason: sport.reason, exit: sport.exit,
        inSeason: inSeason, cycleKey: cycleKey, followed: followed,
        carrierInstalled: !!installed, carrierRemovable: removable, status: "unfollowed"
      };
      if (followed) {
        if (!byAppFollowed[sport.appId]) { byAppFollowed[sport.appId] = []; appOrder.push(sport.appId); }
        byAppFollowed[sport.appId].push(entry);
      }
      return entry;
    });

    var suggestions = [], exits = [];
    appOrder.forEach(function (appId) {
      var group = byAppFollowed[appId];
      var combined = combinedGroupSeason(group, d);
      var groupTitle = group.map(function (s) { return s.title; }).join(" & ");
      group.forEach(function (s) {
        s.yearRound = combined.yearRound;
        s.effectiveSeason = combined.season;
        s.effectiveEndMonthName = combined.endMonthName;
      });
      var inSeasonGroup = group.filter(function (s) { return s.inSeason; });
      var offSeasonGroup = group.filter(function (s) { return !s.inSeason; });
      var installed = byAppId[appId] || null;
      var brand = brandById[appId] || {id: appId, title: appId, mark: appId, tone: "utility"};
      if (!installed && inSeasonGroup.length > 0) {
        var activeSuggest = inSeasonGroup.filter(function (s) { return !state.dismissed[s.cycleKey]; });
        if (activeSuggest.length > 0) {
          var firstS = activeSuggest[0];
          var sTitle = activeSuggest.map(function (s) { return s.title; }).join(" & ");
          var sReason = activeSuggest.length === 1 ? firstS.reason : "You follow " + sTitle + " (" + combined.season + "). " + brand.title + " carries live coverage for both.";
          var sExit = combined.yearRound
            ? "Year-round coverage: " + groupTitle + " span the full year on " + brand.title + ". Unfollow a sport anytime in Sports & seasons to enable off-season cleanup."
            : "Exit plan: R2D2 will offer to remove " + brand.title + " when " + (group.length > 1 ? "your " + groupTitle + " coverage" : "the " + sTitle + " season") + " ends in " + combined.endMonthName + ".";
          suggestions.push({
            kind: "suggest", appId: appId, appTitle: brand.title, mark: brand.mark, tone: brand.tone,
            sports: activeSuggest.map(function (s) { return s.id; }), sportTitle: sTitle,
            season: combined.season, endMonthName: combined.endMonthName, yearRound: combined.yearRound,
            headline: firstS.headline, reason: sReason, exit: sExit,
            cycleKeys: activeSuggest.map(function (s) { return s.cycleKey; })
          });
        }
      } else if (installed && inSeasonGroup.length === 0 && offSeasonGroup.length > 0 && offSeasonGroup[0].carrierRemovable) {
        var activeExit = offSeasonGroup.filter(function (s) { return !state.kept[s.cycleKey]; });
        if (activeExit.length > 0) {
          var firstE = activeExit[0];
          var eTitle = activeExit.map(function (s) { return s.title; }).join(" & ");
          var eReason = activeExit.length === 1 ? firstE.exit : eTitle + " seasons have ended. Remove " + brand.title + " until next season?";
          exits.push({
            kind: "exit", appId: appId, appTitle: brand.title, mark: brand.mark, tone: brand.tone,
            sports: activeExit.map(function (s) { return s.id; }), sportTitle: eTitle,
            season: combined.season, endMonthName: combined.endMonthName, yearRound: false,
            headline: "Season ended.\nClean up?", reason: eReason, exit: eReason,
            cycleKeys: activeExit.map(function (s) { return s.cycleKey; }),
            seasonalInstall: !!state.seasonalInstalls[appId],
            autoRemove: !!(state.seasonalInstalls[appId] && state.autoRemove[appId])
          });
        }
      }
    });

    evaluatedSports.forEach(function (entry) {
      if (!entry.followed) { entry.status = "unfollowed"; return; }
      var group = byAppFollowed[entry.appId] || [];
      var anyInSeason = group.some(function (s) { return s.inSeason; });
      if (entry.inSeason) {
        if (entry.carrierInstalled) entry.status = "installed-active";
        else if (state.dismissed[entry.cycleKey]) entry.status = "dismissed";
        else entry.status = "suggested";
      } else {
        if (!entry.carrierInstalled) entry.status = "off-season";
        else if (!entry.carrierRemovable || anyInSeason || state.kept[entry.cycleKey]) entry.status = "kept";
        else entry.status = "exit-ready";
      }
    });

    return {state: state, sports: evaluatedSports, suggestions: suggestions, exits: exits, items: suggestions.concat(exits)};
  }

  root.OwnerCore = {Service: Service, VoiceFeed: VoiceFeed, normalize: normalize, selectFavorites: selectFavorites, isSportInSeason: isSportInSeason, sportCycleKey: sportCycleKey, normalizeSportsState: normalizeSportsState, evaluateSports: evaluateSports, voiceValue: voiceValue, weatherValue: weatherValue, uris: {list: LIST, launch: LAUNCH}};
  if (typeof module !== "undefined" && module.exports) module.exports = root.OwnerCore;
}(typeof window !== "undefined" ? window : globalThis));
