class OwnedDisplay:
    def __init__(self, display):
        self.x11 = ctypes.CDLL("libX11.so.6")
        self.xtst = ctypes.CDLL("libXtst.so.6")
        self.x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
        self.x11.XOpenDisplay.restype = ctypes.c_void_p
        self.x11.XStringToKeysym.argtypes = [ctypes.c_char_p]
        self.x11.XStringToKeysym.restype = ctypes.c_ulong
        self.x11.XKeysymToKeycode.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
        self.x11.XKeysymToKeycode.restype = ctypes.c_uint
        self.x11.XFlush.argtypes = [ctypes.c_void_p]
        self.x11.XSync.argtypes = [ctypes.c_void_p, ctypes.c_int]
        self.x11.XCloseDisplay.argtypes = [ctypes.c_void_p]
        self.xtst.XTestFakeKeyEvent.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_int, ctypes.c_ulong]
        self.xtst.XTestFakeMotionEvent.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_ulong]
        self.xtst.XTestFakeButtonEvent.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_int, ctypes.c_ulong]
        self.handle = self.x11.XOpenDisplay(display.encode())
        if not self.handle:
            raise RuntimeError("private X display unavailable")
        self.lock = threading.Lock()
        self.fixture_window = None
        self.fixture_nonce = None

    def send(self, body):
        if not valid_input(body):
            raise ValueError("input refused")
        with self.lock:
            if not self.handle:
                raise RuntimeError("private display closed")
            if body["kind"] == "key":
                symbol = self.x11.XStringToKeysym(KEYS[body["key"]].encode())
                code = self.x11.XKeysymToKeycode(self.handle, symbol)
                if not code:
                    raise RuntimeError("key unavailable")
                pressed = self.xtst.XTestFakeKeyEvent(self.handle, code, 1, 0)
                released = self.xtst.XTestFakeKeyEvent(self.handle, code, 0, 0)
                if not pressed or not released:
                    raise RuntimeError('PRIVATE_KEY_FAILED')
            else:
                x, y = round(body["x"] * (WIDTH - 1)), round(body["y"] * (HEIGHT - 1))
                if not self.xtst.XTestFakeMotionEvent(self.handle, -1, x, y, 0):
                    raise RuntimeError('PRIVATE_MOTION_FAILED')
                if body['kind']=='wheel':
                    button=5 if body['deltaY']>0 else 4
                    for _ in range(max(1,min(10,round(abs(body['deltaY'])/120)))):
                        if not self.xtst.XTestFakeButtonEvent(self.handle,button,1,0) or not self.xtst.XTestFakeButtonEvent(self.handle,button,0,0):
                            raise RuntimeError('PRIVATE_WHEEL_FAILED')
                elif body["click"]:
                    pressed = self.xtst.XTestFakeButtonEvent(self.handle, 1, 1, 0)
                    released = self.xtst.XTestFakeButtonEvent(self.handle, 1, 0, 0)
                    if not pressed or not released:
                        raise RuntimeError('PRIVATE_CLICK_FAILED')
            self.x11.XSync(self.handle, 0)

    def close(self):
        with self.lock:
            if self.handle:
                self.x11.XCloseDisplay(self.handle)
                self.handle = None

    fit_fixture = fit_owned_fixture


