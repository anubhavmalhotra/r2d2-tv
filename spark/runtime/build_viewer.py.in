"""Fixed-origin R2D2 private browser viewer with a clear, remote-friendly toolbar."""
import base64,hashlib,json,re
from pathlib import Path
HERE=Path(__file__).resolve().parent
CODECS=('hvc1.1.6.L153.B0','hvc1.1.6.L156.B0','avc1.640033')
STYLE='''
:root{--chrome:#18171f;--panel:#24212d;--line:#ffffff14;--ink:#f5f0fc;--muted:#aaa0b8;--accent:#d7c6ff;--spring:cubic-bezier(.22,1.25,.36,1);--control:clamp(44px,3vw,64px);--voice-ink:#f5f3ed;--voice-cyan:#83ecff;--voice-gold:#e3bd92;--voice-unsure:#cdd2d6;--voice-nothing:#b7bec8;--voice-failed:#edbdba}
*{box-sizing:border-box}html,body{margin:0;background:#000;color:var(--ink);width:100%;height:100%;overflow:hidden;font:clamp(20px,1.46vw,30px)/1.4 system-ui,-apple-system,sans-serif}body{display:flex;flex-direction:column}
button,input{font:inherit;color:inherit}button{cursor:pointer;min-width:44px;min-height:44px;border:1px solid var(--line);border-radius:14px;background:var(--panel);padding:10px 16px;white-space:nowrap;transition:transform 170ms var(--spring),background-color 90ms ease-out}button:hover:not(:disabled){background:#352a40;transform:translateY(-2px)}button:active:not(:disabled){transform:scale(.94)}button:disabled{cursor:default;opacity:.34}button:focus-visible,input:focus-visible,#page:focus-visible{outline:3px solid #eee2ff;outline-offset:3px}
button svg,.address-symbol{width:24px;height:24px;display:block;stroke:currentColor;stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round;pointer-events:none}
.toolbar{position:relative;z-index:2;display:flex;align-items:center;gap:clamp(7px,.65vw,14px);padding:clamp(10px,.7vw,18px) clamp(12px,1vw,24px) 8px;background:var(--chrome);flex:0 0 auto;min-width:0}
.history-controls{display:flex;gap:2px;flex:0 0 auto}.icon-button{display:grid;place-items:center;width:var(--control);height:var(--control);flex:0 0 auto;padding:0;border-radius:14px}.history-controls .icon-button{background:transparent;border-color:transparent;color:#bdb1cd}.history-controls .icon-button:hover:not(:disabled){background:#2a2333}
.address-form{display:flex;flex:1;min-width:100px;gap:8px;align-items:center}.address-wrap{position:relative;flex:1;min-width:0}.address-symbol{position:absolute;left:17px;top:50%;transform:translateY(-50%);width:21px;height:21px;color:#9984b1}.address{width:100%;height:var(--control);min-height:44px;padding:10px 18px 10px 51px;background:#24212d;border:1px solid #ffffff17;border-radius:15px;caret-color:#e4d1ff;text-overflow:clip;font-size:clamp(18px,1.2vw,26px);letter-spacing:-.015em}.address::placeholder{color:#a192b2}.address[readonly]{cursor:pointer}.address:focus-visible{outline-offset:2px}.open-button{background:var(--accent);color:#2c2039;border-color:var(--accent);font-weight:700}.open-button:hover:not(:disabled){background:#eadcff}.close-button,.page-button,.mic-button{color:#cdbbdf}.sound-button{font-size:.64em;padding:8px 12px;height:var(--control)}.sound-button[hidden]{display:none}
.chrome-bottom{display:flex;flex-wrap:wrap;align-items:center;gap:10px;flex:0 0 auto;min-width:0;max-width:100%;min-height:0;padding:0;border:0;background:var(--chrome)}.tabstrip{display:flex;align-items:center;gap:9px;flex:1 1 800px;min-width:0;max-width:100%;padding:3px clamp(12px,1vw,24px) 8px;background:var(--chrome)}.tabstrip[hidden]{display:none}.tab-list{display:flex;flex-wrap:wrap;gap:8px;flex:1;min-width:96px;padding:3px}.tab-item{display:flex;align-items:center;flex:1 1 90px;min-width:90px;max-width:250px;border:1px solid transparent;background:#24202d;border-radius:13px;overflow:hidden}.tab-item.active{background:#3b3046;border-color:#c7a6e846}.tab-button,.tab-close,.new-tab{min-height:44px;border:0;background:transparent;border-radius:10px;font-size:clamp(16px,1.05vw,23px)}.tab-button{min-width:44px;flex:1;padding:9px 13px;text-align:left;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.tab-close{flex:0 0 44px;width:44px;padding:0;color:#ac98bd}.tab-close:hover{color:#fff}.new-tab{display:grid;place-items:center;width:44px;min-width:44px;height:44px;padding:0;background:#28212f;flex:0 0 auto}.new-tab svg{width:21px;height:21px}.tab-button:focus-visible,.tab-close:focus-visible{outline-offset:-3px}.tab-status{font-size:.58em;color:#ad99be;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:25vw;flex:0 1 auto}.tab-status:empty{display:none}.tabstrip.busy .tab-item{opacity:.65}
.voice-status{display:flex;align-items:center;gap:10px;flex:0 1 auto;min-width:0;max-width:calc(100% - 48px);margin:3px clamp(12px,1vw,24px) 8px 0;padding:0 5px 0 12px;min-height:44px;border:1px solid #cba5db30;border-radius:12px;background:#2e2236;color:#dbc7ea;font-size:.56em}.voice-status[hidden]{display:none}.voice-label{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.voice-status button{min-height:44px;min-width:58px;padding:4px 9px;border:0;background:transparent;font-size:inherit}.mic-button[aria-pressed=true]{background:#56304b;color:#ffd1e7;border-color:#e6a8cf5c}
.page{position:relative;overflow:hidden;flex:1;min-height:0;background:#000;outline:none}.page video{display:block;width:100%;height:100%;object-fit:contain;background:#000}.focus-hint{position:absolute;z-index:3;bottom:12px;left:50%;transform:translateX(-50%);padding:6px 14px;border:1px solid #bba1ce30;border-radius:99px;background:#211a2be8;color:#c5b2d8;font-size:.65em;pointer-events:none;white-space:nowrap;opacity:0;transition:opacity .15s}.page-mode .toolbar,.page-mode .tabstrip,.page-mode .chrome-bottom,.page-mode .focus-hint{display:none}
.state-panel{position:absolute;inset:0;z-index:2;display:flex;align-items:center;justify-content:center;background:#0e0b13}.state-panel[hidden]{display:none}.state-card{max-width:600px;text-align:center;padding:40px}.state-symbol{width:68px;height:68px;margin:0 auto 22px;border:1px solid #ad91c63b;border-radius:20px;background:#282034;display:grid;place-items:center;color:#ceb4e6;font-size:30px}.state-card h1{font-size:1.65em;letter-spacing:-.04em;line-height:1.2;margin:0 0 12px}.state-card p{color:#b1a1bf;margin:0 0 24px;line-height:1.55}.state-actions{display:flex;justify-content:center;gap:14px}.state-actions button[hidden]{display:none}.quiet-hint{display:block;font-size:.72em;color:#8d779f;margin-top:18px}.toast{position:absolute;z-index:5;top:18px;left:50%;transform:translateX(-50%);max-width:80%;border:1px solid #c6a6de38;background:#30203ff5;color:#f0e2fa;border-radius:14px;padding:12px 22px;text-align:center;font-size:.8em}.toast[hidden]{display:none}.session-closed .address,.session-closed .open-button,.session-closed .page-button{opacity:.4}.spinner{width:26px;height:26px;border:2px solid #685179;border-top-color:#d7c6ff;border-radius:50%;animation:turn 1s linear infinite}@keyframes turn{to{transform:rotate(360deg)}}
.direct-editor{position:fixed;z-index:4;margin:0;padding:0;min-width:0;min-height:0}.direct-editor[hidden]{display:none}.direct-editor input,.direct-editor textarea{display:block;width:100%;height:100%;min-height:0;margin:0;padding:2px 6px;border:1px solid #c9a8ec;border-radius:3px;background:#fff;color:#111;font:inherit;line-height:1.15;resize:none;outline:2px solid #c9a8ec}.direct-editor input[hidden],.direct-editor textarea[hidden]{display:none}
.remote-fullscreen .toolbar,.remote-fullscreen .tabstrip,.remote-fullscreen .chrome-bottom,.remote-fullscreen .focus-hint{display:none}.remote-fullscreen .page{width:100%;height:100%;flex:1}.play-sound{position:absolute;z-index:5;bottom:30px;left:50%;transform:translateX(-50%);background:#e5d5fa;color:#2a1d36}.play-sound[hidden]{display:none}.page-inactive button,.page-inactive .focus-hint{transition:none}.page-inactive .spinner{animation-play-state:paused}
.voice-card{position:absolute;z-index:6;top:18px;left:0;right:0;margin:0 auto;display:flex;align-items:center;gap:24px;width:fit-content;min-width:min(560px,calc(100% - 32px));max-width:min(960px,calc(100% - 32px));height:112px;padding:22px 28px;border:2px solid #ffffff20;border-radius:24px;background:#0b1119f2;box-shadow:0 14px 70px #0006;color:var(--voice-ink);font-family:Arial,Helvetica,sans-serif;line-height:1.2;pointer-events:none;--voice-tone:var(--voice-ink);animation:voice-in 180ms var(--spring) both}.voice-card[hidden]{display:none}.voice-card[data-lines="2"]{height:156px}.voice-card[data-exit="1"]{animation:voice-out 180ms ease-in both}.page-mode .voice-card,.remote-fullscreen .voice-card{top:54px}@keyframes voice-in{from{opacity:0;transform:translateY(-12px)}}@keyframes voice-out{to{opacity:0;transform:translateY(-12px)}}
.voice-disc{flex:0 0 56px;width:56px;height:56px;display:grid;place-items:center;border:3px solid var(--voice-tone);border-radius:50%;background:#ffffff0d;color:var(--voice-tone)}.voice-card svg{display:none;width:28px;height:28px;stroke:currentColor;stroke-width:2.4;fill:none;stroke-linecap:round;stroke-linejoin:round}.voice-card [data-glyph=dots]{stroke-width:4}.voice-text{display:flex;flex-direction:column;justify-content:center;gap:8px;flex:1 1 auto;min-width:0}.voice-title,.voice-detail{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.voice-title{font-size:34px;font-weight:700}.voice-detail{font-size:26px;color:#d8dce1}.voice-detail[hidden]{display:none}.voice-badge{--voice-badge:var(--voice-nothing);display:flex;align-items:center;gap:8px;flex:0 0 auto;height:36px;margin-left:auto;padding:0 14px;border:2px solid var(--voice-badge);border-radius:18px;color:var(--voice-badge);font-size:20px;font-weight:600;white-space:nowrap}.voice-badge[hidden]{display:none}.voice-card .voice-badge svg{width:20px;height:20px}
.voice-card[data-tone=listen],.voice-card[data-tone=done]{--voice-tone:var(--voice-cyan)}.voice-card[data-tone=work],.voice-card[data-tone=sent],.voice-card[data-tone=ask]{--voice-tone:var(--voice-gold)}.voice-card[data-tone=unsure]{--voice-tone:var(--voice-unsure)}.voice-card[data-tone=nothing]{--voice-tone:var(--voice-nothing)}.voice-card[data-tone=failed]{--voice-tone:var(--voice-failed)}.voice-badge[data-badge=confirmed]{--voice-badge:var(--voice-cyan);border-color:transparent;background:#83ecff1f}.voice-badge[data-badge=sent],.voice-badge[data-badge=waiting]{--voice-badge:var(--voice-gold)}.voice-badge[data-badge=unconfirmed]{--voice-badge:var(--voice-unsure);border-style:dashed}.voice-badge[data-badge=failed]{--voice-badge:var(--voice-failed)}
.voice-card[data-tone=listen] .voice-disc [data-glyph=mic],.voice-card[data-tone=work] .voice-disc [data-glyph=dots],.voice-card[data-tone=done] .voice-disc [data-glyph=check],.voice-card[data-tone=sent] .voice-disc [data-glyph=arrow],.voice-card[data-tone=unsure] .voice-disc [data-glyph=question],.voice-card[data-tone=nothing] .voice-disc [data-glyph=dash],.voice-card[data-tone=failed] .voice-disc [data-glyph=cross],.voice-card[data-tone=ask] .voice-disc [data-glyph=hourglass],.voice-card[data-tone=idle] .voice-disc [data-glyph=dot],.voice-card[data-tone=ready] .voice-disc [data-glyph=dot],.voice-badge[data-badge=confirmed] [data-glyph=check],.voice-badge[data-badge=sent] [data-glyph=arrow],.voice-badge[data-badge=unconfirmed] [data-glyph=question],.voice-badge[data-badge=nothing] [data-glyph=dash],.voice-badge[data-badge=changed] [data-glyph=dash],.voice-badge[data-badge=failed] [data-glyph=cross],.voice-badge[data-badge=waiting] [data-glyph=hourglass]{display:block}.page-inactive .voice-card{animation:none}
@media(max-width:1100px){.toolbar{gap:6px;padding:10px 10px 6px}.history-controls{gap:0}.address{padding-left:42px;font-size:18px}.address-symbol{left:13px;width:18px;height:18px}.sound-button{font-size:.58em;padding:5px 8px}.tabstrip{padding:3px 10px 6px}.voice-status{margin-right:10px;max-width:35vw}.voice-status button{min-width:50px}}
@media(prefers-reduced-motion:reduce){button,.focus-hint{transition:none}button:hover:not(:disabled),button:active:not(:disabled){transform:none}.spinner{animation:none}.voice-card,.voice-card[data-exit="1"]{animation:none}}
'''
def build(token,codec=CODECS[0],history_enabled=False,tabs_enabled=False,text_enabled=False,audio_enabled=False,layout_enabled=False,fixed_viewport=False,ring_enabled=False,transport="mse"):
 if transport not in ('mse','webrtc'):raise ValueError('DISPLAY_TRANSPORT')
 if not isinstance(token,str)or not re.fullmatch('[a-f0-9]{48}',token)or codec not in CODECS or type(history_enabled)is not bool or type(tabs_enabled)is not bool or type(text_enabled)is not bool or type(audio_enabled)is not bool or type(layout_enabled)is not bool or type(fixed_viewport)is not bool or type(ring_enabled)is not bool or ring_enabled and (not audio_enabled or not fixed_viewport) or fixed_viewport and not layout_enabled:raise ValueError('FIXED_VIEWER_CONFIG')
 script='window.BAAZ_STREAM='+json.dumps({'token':token,'codec':'VP9'if transport=='webrtc'else codec,'transport':transport,'history':history_enabled,'tabs':tabs_enabled,'text':text_enabled,'audio':audio_enabled,'layout':layout_enabled,'fixedViewport':fixed_viewport,'ring':ring_enabled},separators=(',',':'))+';\n'+(('\n'.join((HERE/name).read_text()for name in ('rtc_crypto.js','rtc_policy.js','rtc_measurement.js','rtc_measurement_pack.js','rtc_viewer.js'))+'\n')if transport=='webrtc'else'')+(HERE/'viewer.js').read_text()
 digest=base64.b64encode(hashlib.sha256(script.encode()).digest()).decode()
 csp="default-src 'none'; script-src 'sha256-"+digest+"'; style-src 'unsafe-inline'; connect-src 'self'; media-src blob:; img-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
 icon=lambda path:'<svg viewBox="0 0 24 24" aria-hidden="true"><path d="'+path+'"/></svg>'
 # Voice receipt glyphs are static inline SVG (img-src 'none'); CSS shows one by data state.
 glyph={'mic':'M9 6a3 3 0 0 1 6 0v5a3 3 0 0 1-6 0V6M6 11a6 6 0 0 0 12 0M12 17v3','dots':'M6 12h.01M12 12h.01M18 12h.01','check':'m5 12.5 4.5 4.5L19 7.5','arrow':'M7 17 17 7M9 7h8v8','question':'M9.2 9a2.9 2.9 0 1 1 4.2 2.6c-.9.5-1.4 1.2-1.4 2.2M12 18h.01','dash':'M6 12h12','cross':'m7 7 10 10M17 7 7 17','hourglass':'M7 3h10M7 21h10M8 3v2c0 3 4 4.5 4 7s-4 4-4 7v2M16 3v2c0 3-4 4.5-4 7s4 4 4 7v2','dot':'M12 8.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 1 1 0-7'}
 glyphs=lambda names:''.join('<svg viewBox="0 0 24 24" data-glyph="'+name+'" aria-hidden="true"><path d="'+glyph[name]+'"/></svg>'for name in names)
 card='<div id="voice-card" class="voice-card" role="status" aria-live="polite" hidden><span class="voice-disc">'+glyphs(('mic','dots','check','arrow','question','dash','cross','hourglass','dot'))+'</span><span class="voice-text"><span id="voice-card-title" class="voice-title"></span><span id="voice-card-detail" class="voice-detail" hidden></span></span><span id="voice-card-badge" class="voice-badge" hidden>'+glyphs(('check','arrow','question','dash','cross','hourglass'))+'<span id="voice-card-word"></span></span></div>'
 html='''<!doctype html><html lang="en"><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="'''+csp+'''"><meta name="viewport" content="width=device-width,initial-scale=1"><title>R2D2 · Private browser</title><style>'''+STYLE+'''</style></head><body><header id="toolbar" class="toolbar" aria-label="Browser controls"><nav class="history-controls" aria-label="Page navigation"><button id="back" class="icon-button" type="button" aria-label="Back" title="Back">'''+icon('m14 5-7 7 7 7M7 12h13')+'''</button><button id="forward" class="icon-button" type="button" aria-label="Forward" title="Forward">'''+icon('m10 5 7 7-7 7M17 12H4')+'''</button><button id="reload" class="icon-button" type="button" aria-label="Reload" title="Reload">'''+icon('M20 7v5h-5M20 12a8 8 0 1 0-2 6M20 7l-3-3')+'''</button></nav><form id="address-form" class="address-form" autocomplete="off" novalidate><div class="address-wrap"><svg class="address-symbol" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><input id="address" class="address" type="url" inputmode="url" enterkeyhint="go" maxlength="1600" autocomplete="off" autocorrect="off" autocapitalize="none" spellcheck="false" readonly placeholder="Google" aria-label="Search Google or enter website address"></div><button id="go" class="open-button icon-button" type="submit" aria-label="Go to address or search Google" title="Go">'''+icon('M4 12h16m-7-7 7 7-7 7')+'''</button></form><button id="sound" class="sound-button" type="button" hidden>Sound on</button><button id="mic" class="icon-button mic-button" type="button" aria-label="Voice input" aria-pressed="false" title="Voice input">'''+icon('M8 6a4 4 0 0 1 8 0v5a4 4 0 0 1-8 0V6M5 10v2a7 7 0 0 0 14 0v-2M12 19v3M8 22h8')+'''</button><button id="browse-page" class="page-button icon-button" type="button" aria-label="Fullscreen page" title="Fullscreen page. Back returns to browser controls.">'''+icon('M9 3H3v6M15 3h6v6M3 15v6h6M21 15v6h-6')+'''</button><button id="end-session" class="close-button icon-button" type="button" aria-label="Close browser and return Home" title="Close browser">'''+icon('m3 11 9-8 9 8M6 9v11h12V9M10 20v-7h4v7')+'''</button></header><div id="chrome-bottom" class="chrome-bottom"><nav id="tabstrip" class="tabstrip" aria-label="Private browser tabs" hidden><div id="tabs-list" class="tab-list" role="tablist" aria-label="Open tabs"></div><span id="tabs-status" class="tab-status" role="status" aria-live="polite">Loading tabs...</span><button id="new-tab" class="new-tab" type="button" aria-label="New private tab" title="New private tab" disabled>'''+icon('M12 5v14M5 12h14')+'''</button></nav><div id="voice-status" class="voice-status" hidden><span id="voice-label" class="voice-label" role="status" aria-live="polite"></span><button id="cancel-voice" type="button" aria-label="Cancel voice input">Cancel</button></div></div><form id="editor-form" class="direct-editor" autocomplete="off" novalidate hidden aria-label="Website text field"><input id="editor-input" type="text" enterkeyhint="enter" maxlength="2048" autocomplete="off" autocorrect="off" autocapitalize="none" spellcheck="false" readonly aria-label="Website text"><textarea id="editor-area" maxlength="2048" autocomplete="off" autocorrect="off" autocapitalize="none" spellcheck="false" readonly hidden aria-label="Website text"></textarea></form><main id="page" class="page" tabindex="0" aria-label="Website. Back returns to browser controls."><video id="video" autoplay '''+('' if audio_enabled else 'muted ')+'''playsinline></video><div id="state-panel" class="state-panel" role="status" aria-live="polite"><div class="state-card"><div id="state-symbol" class="state-symbol"><span class="spinner"></span></div><h1 id="state-title">Opening your private browser</h1><p id="state-description">Getting your page ready. This usually takes a moment.</p><div class="state-actions"><button id="retry" class="open-button" type="button" hidden>Try again</button></div><span id="home-hint" class="quiet-hint">Home on your remote returns to R2D2.</span></div></div><button id="play-sound" class="play-sound" type="button" hidden>Play sound</button><div id="status" class="toast" role="status" aria-live="polite" hidden></div>'''+card+'''<div class="focus-hint">Back · Browser controls</div></main><script>'''+script+'''</script></body></html>'''
 return html.encode()
if __name__=='__main__':
 import argparse
 p=argparse.ArgumentParser(description=__doc__);p.add_argument('--token',required=True);p.add_argument('--codec',choices=CODECS,default=CODECS[0]);p.add_argument('--history-enabled',action='store_true');p.add_argument('--tabs-enabled',action='store_true');p.add_argument('--text-enabled',action='store_true');p.add_argument('--audio-enabled',action='store_true');p.add_argument('--layout-enabled',action='store_true');p.add_argument('--fixed-viewport',action='store_true');p.add_argument('--output',type=Path,required=True);a=p.parse_args();a.output.write_bytes(build(a.token,a.codec,a.history_enabled,a.tabs_enabled,a.text_enabled,a.audio_enabled,a.layout_enabled,a.fixed_viewport));print(json.dumps({'bytes':a.output.stat().st_size,'sha256':hashlib.sha256(a.output.read_bytes()).hexdigest(),'networkCalls':0}))
