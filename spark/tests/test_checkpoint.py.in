import test_media_ring as fixture
from test_sparse import sparse_pair,ring
from test_initial import native_init

def interleaved_pairs():
 # Fixed scalar codec schedule; all boxes/payloads are generated test bytes.
 rows=[{'seq': 1, 'video': [256, 256], 'vd': 0, 'sync': True, 'audio': [431, 1024, 1024], 'ad': 0}, {'seq': 2, 'video': [256, 256], 'vd': 512, 'sync': False}, {'seq': 3, 'video': [256, 256], 'vd': 1024, 'sync': False}, {'seq': 4, 'video': [256, 256], 'vd': 1536, 'sync': False}, {'seq': 5, 'video': [256, 256], 'vd': 2048, 'sync': False}, {'seq': 6, 'video': [256, 256], 'vd': 2560, 'sync': False}, {'seq': 7, 'video': [256, 256], 'vd': 3072, 'sync': False}, {'seq': 8, 'video': [256, 256], 'vd': 3584, 'sync': False}, {'seq': 9, 'video': [256, 256], 'vd': 4096, 'sync': False}, {'seq': 10, 'video': [256, 256], 'vd': 4608, 'sync': False}, {'seq': 11, 'video': [256, 256], 'vd': 5120, 'sync': False}, {'seq': 12, 'video': [256, 256], 'vd': 5632, 'sync': False}, {'seq': 13, 'video': [256, 256], 'vd': 6144, 'sync': False}, {'seq': 14, 'video': [256], 'vd': 6656, 'sync': False, 'audio': [1024, 1024], 'ad': 2479}, {'seq': 15, 'audio': [1024, 1024], 'ad': 4527}, {'seq': 16, 'audio': [1024, 1024], 'ad': 6575}, {'seq': 17, 'audio': [1024, 1024], 'ad': 8623}, {'seq': 18, 'audio': [1024, 1024], 'ad': 10671}, {'seq': 19, 'audio': [1024, 1024], 'ad': 12719}, {'seq': 20, 'audio': [1024, 1024], 'ad': 14767}, {'seq': 21, 'audio': [1024, 1024], 'ad': 16815}, {'seq': 22, 'audio': [1024, 1024], 'ad': 18863}, {'seq': 23, 'video': [256, 256], 'vd': 6912, 'sync': False, 'audio': [1024, 1024], 'ad': 20911}, {'seq': 24, 'video': [256, 256], 'vd': 7424, 'sync': False, 'audio': [1024], 'ad': 22959}, {'seq': 25, 'video': [256, 256], 'vd': 7936, 'sync': False}, {'seq': 26, 'video': [256, 256], 'vd': 8448, 'sync': False}, {'seq': 27, 'video': [256], 'vd': 8960, 'sync': False, 'audio': [1024, 1024], 'ad': 23983}, {'seq': 28, 'audio': [1024, 1024], 'ad': 26031}, {'seq': 29, 'video': [256, 256], 'vd': 9216, 'sync': False, 'audio': [1024], 'ad': 28079}, {'seq': 30, 'video': [256, 256], 'vd': 9728, 'sync': False, 'audio': [1024, 1024], 'ad': 29103}, {'seq': 31, 'video': [256, 256], 'vd': 10240, 'sync': False, 'audio': [1024], 'ad': 31151}, {'seq': 32, 'video': [256, 256], 'vd': 10752, 'sync': False, 'audio': [1024, 1024], 'ad': 32175}, {'seq': 33, 'video': [256, 256], 'vd': 11264, 'sync': False, 'audio': [1024, 1024], 'ad': 34223}, {'seq': 34, 'video': [256, 256], 'vd': 11776, 'sync': False, 'audio': [1024, 1024], 'ad': 36271}, {'seq': 35, 'video': [256, 256], 'vd': 12288, 'sync': False, 'audio': [1024], 'ad': 38319}, {'seq': 36, 'video': [256, 256], 'vd': 12800, 'sync': False, 'audio': [1024, 1024], 'ad': 39343}, {'seq': 37, 'video': [256, 256], 'vd': 13312, 'sync': False, 'audio': [1024], 'ad': 41391}, {'seq': 38, 'video': [256, 256], 'vd': 13824, 'sync': False, 'audio': [1024, 1024], 'ad': 42415}, {'seq': 39, 'video': [256, 256], 'vd': 14336, 'sync': False, 'audio': [1024], 'ad': 44463}, {'seq': 40, 'video': [256, 256], 'vd': 14848, 'sync': False, 'audio': [1024, 1024], 'ad': 45487}, {'seq': 41, 'video': [256, 256], 'vd': 15360, 'sync': True, 'audio': [1024, 1024], 'ad': 47535}, {'seq': 42, 'video': [256, 256], 'vd': 15872, 'sync': False, 'audio': [1024, 1024], 'ad': 49583}, {'seq': 43, 'video': [256, 256], 'vd': 16384, 'sync': False, 'audio': [1024], 'ad': 51631}, {'seq': 44, 'video': [256, 256], 'vd': 16896, 'sync': False, 'audio': [1024], 'ad': 52655}, {'seq': 45, 'video': [256, 256], 'vd': 17408, 'sync': False, 'audio': [1024, 1024], 'ad': 53679}, {'seq': 46, 'video': [256, 256], 'vd': 17920, 'sync': False, 'audio': [1024], 'ad': 55727}, {'seq': 47, 'video': [256, 256], 'vd': 18432, 'sync': False, 'audio': [1024, 1024], 'ad': 56751}, {'seq': 48, 'video': [256, 256], 'vd': 18944, 'sync': False, 'audio': [1024], 'ad': 58799}, {'seq': 49, 'video': [256, 256], 'vd': 19456, 'sync': False, 'audio': [1024, 1024], 'ad': 59823}, {'seq': 50, 'video': [256, 256], 'vd': 19968, 'sync': False, 'audio': [1024], 'ad': 61871}, {'seq': 51, 'video': [256, 256], 'vd': 20480, 'sync': False, 'audio': [1024, 1024], 'ad': 62895}, {'seq': 52, 'video': [256, 256], 'vd': 20992, 'sync': False, 'audio': [1024, 1024], 'ad': 64943}, {'seq': 53, 'video': [256, 256], 'vd': 21504, 'sync': False, 'audio': [1024, 1024], 'ad': 66991}, {'seq': 54, 'video': [256, 256], 'vd': 22016, 'sync': False, 'audio': [1024], 'ad': 69039}, {'seq': 55, 'video': [256, 256], 'vd': 22528, 'sync': False}, {'seq': 56, 'video': [256], 'vd': 23040, 'sync': False, 'audio': [1024, 1024], 'ad': 70063}, {'seq': 57, 'video': [256, 256], 'vd': 23296, 'sync': False, 'audio': [1024, 1024], 'ad': 72111}, {'seq': 58, 'video': [256, 256], 'vd': 23808, 'sync': False, 'audio': [1024], 'ad': 74159}, {'seq': 59, 'video': [256, 256], 'vd': 24320, 'sync': False, 'audio': [1024, 1024], 'ad': 75183}, {'seq': 60, 'video': [256, 256], 'vd': 24832, 'sync': False, 'audio': [1024], 'ad': 77231}, {'seq': 61, 'video': [256, 256], 'vd': 25344, 'sync': False, 'audio': [1024, 1024], 'ad': 78255}, {'seq': 62, 'video': [256, 256], 'vd': 25856, 'sync': False, 'audio': [1024, 1024], 'ad': 80303}, {'seq': 63, 'video': [256, 256], 'vd': 26368, 'sync': False, 'audio': [1024, 1024], 'ad': 82351}, {'seq': 64, 'video': [256, 256], 'vd': 26880, 'sync': False}]
 return [sparse_pair(**row)for row in rows]

class Checkpoints(unittest.TestCase):
 def test_new_idr_group_waits_for_audio_even_while_old_endpoints_align(self):
  r=ring(clock=lambda:0);r.append(*sparse_pair(1,video=[256]*32,audio=[1024]*26,sync=True));old=r.resume().cursor
  r.append(*sparse_pair(2,video=[256],vd=8192,sync=True))
  for seq in range(3,9):
   try:r.append(*sparse_pair(seq,video=[256],vd=8192+(seq-2)*256))
   except m.MediaError as exc:self.fail('bounded IDR group must wait for audio: '+str(exc))
  self.assertEqual(r.next_index,7);self.assertEqual(r.resume().cursor,old);self.assertGreater(r.snapshot()['pendingBytes'],0)
  r.append(*sparse_pair(9,audio=[1024]*4,ad=26624));self.assertEqual(r.next_index,9);self.assertEqual(r.snapshot()['pendingBytes'],0);self.assertEqual(r.resume().cursor.index,1)
 def test_persistent_skew_cannot_accumulate_a_long_unpublished_span(self):
  r=ring(clock=lambda:0);r.append(*sparse_pair(1,video=[256],audio=[1024],sync=True));r.append(*sparse_pair(2,video=[256]*12,vd=256))
  r.append(*sparse_pair(3,video=[256]*32,audio=[1024]*25,vd=3328,ad=1024));self.assertEqual(r.next_index,1)
  with self.assertRaisesRegex(m.MediaError,'AV_INTERLEAVE_SPAN'):r.append(*sparse_pair(4,video=[256]*32,audio=[1024]*25,vd=11520,ad=26624))
  self.assertEqual((r.next_index,r.prior),(1,{1:256,2:1024}));self.assertEqual(r.snapshot()['pendingBytes'],0)
 def test_pending_bytes_are_bounded_before_checkpoint(self):
  def large(seq,vd,duration):
   moof,_=sparse_pair(seq,video=[duration],vd=vd);moof=bytearray(moof);payload=(2).to_bytes(4,'big')+b'\x02\x01'
   size=4*1024*1024+1024;payload=(size-4).to_bytes(4,'big')+payload[4:]+b'\0'*(size-len(payload))
   p=moof.index(b'trun');moof[p+20:p+24]=size.to_bytes(4,'big');return bytes(moof),fixture.box(b'mdat',payload)
  r=ring();r.append(*sparse_pair(1,video=[256],audio=[1024],sync=True));r.append(*large(2,256,3072));self.assertGreater(r.snapshot()['pendingBytes'],4*1024*1024)
  with self.assertRaisesRegex(m.MediaError,'AV_INTERLEAVE_BOUND'):r.append(*large(3,3328,256))
  self.assertEqual(r.next_index,1);self.assertEqual(r.snapshot()['pendingBytes'],0)
 def test_catching_up_fragment_cannot_bypass_pending_count_cap(self):
  r=ring();r.append(*sparse_pair(1,video=[256],audio=[1024],sync=True));r.append(*sparse_pair(2,video=[256]*8,vd=256))
  for seq in range(3,66):r.append(*sparse_pair(seq,video=[1],vd=2304+seq-3))
  self.assertEqual(len(r.unpublished),64)
  with self.assertRaisesRegex(m.MediaError,'AV_INTERLEAVE_BOUND'):r.append(*sparse_pair(66,audio=[1024]*5,ad=1024))
  self.assertEqual((r.next_index,r.prior),(1,{1:256,2:1024}));self.assertEqual(r.snapshot()['pendingBytes'],0)
 def test_constructed_numeric_lead_catchup_is_private_then_exact_atomic_order(self):
  pairs=interleaved_pairs();r=ring();cursor=None;frontier=[]
  for seq,pair in enumerate(pairs,1):
   try:r.append(*pair)
   except m.MediaError as exc:self.fail('valid constructed mux order rejected: '+str(exc))
   frontier.append(r.next_index)
   if seq==4:cursor=m.Cursor(r.epoch,4)
   if 5<=seq<=19:
    self.assertEqual(r.next_index,4);self.assertIsNone(r.read(cursor));self.assertGreater(r.snapshot()['pendingBytes'],0)
   if seq==20:self.assertEqual(r.next_index,20);self.assertEqual(r.snapshot()['pendingBytes'],0)
  self.assertEqual(r.next_index,64);self.assertEqual(r.prior,{1:27392,2:84399});self.assertEqual(r.snapshot()['pendingBytes'],0)
  cursor=r.resume(latest=False).cursor
  for pair in pairs:
   frag,cursor=r.read(cursor);self.assertEqual((frag.moof,frag.mdat),pair)
  self.assertIsNone(r.read(cursor));self.assertTrue(r.bootstrap_seen)
 def test_private_track_clock_gap_does_not_publish_any_staged_member(self):
  r=ring();pairs=interleaved_pairs()
  for p in pairs[:8]:r.append(*p)
  before=(r.next_index,r.bytes,r.count,dict(r.prior))
  with self.assertRaisesRegex(m.MediaError,'DECODE_GAP_OR_OVERLAP'):r.append(*sparse_pair(9,video=[256],vd=4097))
  self.assertEqual((r.next_index,r.bytes,r.count,dict(r.prior)),before);self.assertEqual(r.snapshot()['pendingBytes'],0)
 def test_missing_track_fails_media_cap_without_advancing_frontier(self):
  r=ring();r.append(*sparse_pair(1,video=[256],audio=[1024],sync=True));before=(r.next_index,r.prior.copy())
  with self.assertRaisesRegex(m.MediaError,'AV_INTERLEAVE_BOUND'):r.append(*sparse_pair(2,video=[256]*64,vd=256))
  self.assertEqual((r.next_index,r.prior),before);self.assertEqual(r.snapshot()['pendingBytes'],0)
 def test_pending_fragment_cap_and_wall_deadline_fail_closed(self):
  now=[0.0];r=ring(clock=lambda:now[0]);r.append(*sparse_pair(1,video=[256],audio=[1024],sync=True))
  r.append(*sparse_pair(2,video=[256]*8,vd=256))
  for seq in range(3,66):r.append(*sparse_pair(seq,video=[1],vd=2304+seq-3))
  self.assertEqual(len(r.unpublished),64);before=r.next_index
  with self.assertRaisesRegex(m.MediaError,'AV_INTERLEAVE_BOUND'):r.append(*sparse_pair(66,video=[1],vd=2367))
  self.assertEqual(r.next_index,before)
  for operation in ('read','resume','append'):
   now[0]=0;r=ring(clock=lambda:now[0]);r.append(*sparse_pair(1,video=[256],audio=[1024],sync=True));r.append(*sparse_pair(2,video=[256]*8,vd=256));now[0]=1
   with self.subTest(operation=operation),self.assertRaisesRegex(m.MediaError,'AV_INTERLEAVE_TIMEOUT'):
    if operation=='read':r.read(m.Cursor(r.epoch,1))
    elif operation=='resume':r.resume()
    else:r.append(*sparse_pair(3,audio=[1024]*8,ad=1024))
   self.assertEqual(r.next_index,1);self.assertEqual(r.snapshot()['pendingBytes'],0)
 def test_audio_only_initial_prefix_cannot_resume_or_finish(self):
  r=ring();r.append(*sparse_pair(1,audio=[1024]*5));self.assertEqual(r.next_index,0)
  with self.assertRaisesRegex(m.MediaError,'NO_ACCESS_POINT'):r.resume()
  with self.assertRaisesRegex(m.MediaError,'TERMINAL_EOF_REQUIRED'):r.finish()
  with self.assertRaisesRegex(m.MediaError,'AV_CHECKPOINT_REQUIRED'):r._finish_eof()
 def test_initial_origins_and_first_delta_remain_strict(self):
  r=ring()
  with self.assertRaisesRegex(m.MediaError,'AV_CLOCK_SKEW'):r.append(*sparse_pair(1,video=[256],audio=[1024],vd=10000,sync=True))
  self.assertEqual(r.next_index,0)
  r=ring()
  with self.assertRaisesRegex(m.MediaError,'INITIAL_IDR_REQUIRED'):r.append(*sparse_pair(1,video=[256],audio=[1024]))
  self.assertEqual(r.next_index,0)
 def test_idr_group_is_not_resumable_without_audio_coverage(self):
  r=ring();r.append(*sparse_pair(1,video=[256],audio=[1024],sync=True));old=r.resume().cursor
  r.append(*sparse_pair(2,video=[256],vd=256,sync=True));self.assertEqual(r.resume().cursor,old)
  r.append(*sparse_pair(3,audio=[1024],ad=1024));self.assertEqual(r.resume().cursor.index,1)
 def test_checkpoint_endpoint_gate_is_still_exact_one_hundred_ms(self):
  r=ring();r.append(*sparse_pair(1,video=[256],audio=[1024],sync=True));r.append(*sparse_pair(2,video=[256]*8,vd=256));self.assertEqual(r.next_index,1)
  # Audio catches up just far enough to synchronize the preserved original
  # endpoints; a preceding single frame remains staged.
  r.append(*sparse_pair(3,audio=[1024],ad=1024));self.assertEqual(r.next_index,1)
  r.append(*sparse_pair(4,audio=[1024],ad=2048));self.assertEqual(r.next_index,4)
 def test_original_producer_contract_staged_fragment_is_not_terminal_eof(self):
  raw=b''.join(native_init())+b''.join(b''.join(p)for p in interleaved_pairs());r=m.MediaRing('a'*32);p=m.Producer(r,io.BytesIO(raw).read);self.assertEqual(p.step(),'init')
  for seq in range(1,65):self.assertEqual(p.step(),'fragment')
  self.assertEqual(p.step(),'end');self.assertTrue(r.ended);self.assertEqual(r.next_index,64)
 def test_clean_eof_does_not_publish_unmatched_final_track(self):
  first=sparse_pair(1,video=[256,256],audio=[1024],sync=True);late=sparse_pair(2,video=[256]*12,vd=512)
  raw=b''.join(native_init()+first+late);r=m.MediaRing('a'*32);p=m.Producer(r,io.BytesIO(raw).read);p.step();p.step();p.step()
  self.assertEqual(r.next_index,1)
  with self.assertRaisesRegex(m.MediaError,'AV_CHECKPOINT_REQUIRED'):p.step()
  self.assertEqual(r.next_index,1);self.assertFalse(r.ended);self.assertEqual(r.snapshot()['pendingBytes'],0)
 def test_terminal_aac_trim_and_private_batch_publish_together_only_after_eof(self):
  first=sparse_pair(1,video=[256,256],audio=[1024],sync=True);late=sparse_pair(2,video=[256]*12,vd=512);last=sparse_pair(3,audio=[1024]*11+[256],ad=1024)
  raw=b''.join(native_init()+first+late+last);f=io.BytesIO(raw);r=m.MediaRing('a'*32);seen=[]
  def read(n):
   if f.tell()==len(raw):seen.append((r.next_index,r.snapshot()['pendingBytes'],r.ended))
   return f.read(n)
  p=m.Producer(r,read);p.step();p.step();p.step();self.assertEqual(r.next_index,1);self.assertEqual(p.step(),'fragment')
  self.assertTrue(seen and all(index==1 and amount>0 and ended is False for index,amount,ended in seen));self.assertEqual(r.next_index,3);self.assertTrue(r.ended and r.terminal_audio_trim)
  cursor=r.resume(latest=False).cursor
  for pair in (first,late,last):frag,cursor=r.read(cursor);self.assertEqual((frag.moof,frag.mdat),pair)
 def test_private_idr_is_unavailable_until_matching_audio_batch_is_published(self):
  r=ring();r.append(*sparse_pair(1,video=[256],audio=[1024],sync=True));r.append(*sparse_pair(2,video=[256]*27,audio=[1024]*21,vd=256,ad=1024));old=r.resume().cursor
  rap=sparse_pair(3,video=[256]*10,vd=7168,sync=True);r.append(*rap);self.assertEqual(r.next_index,2);self.assertEqual(r.resume().cursor,old)
  audio=sparse_pair(4,audio=[1024]*4,ad=22528);r.append(*audio);res=r.resume();self.assertEqual(res.cursor.index,2)
  frag,cursor=r.read(res.cursor);self.assertTrue(frag.access_point);self.assertEqual((frag.moof,frag.mdat),rap);frag,cursor=r.read(cursor);self.assertEqual((frag.moof,frag.mdat),audio)
if __name__=='__main__':unittest.main()
