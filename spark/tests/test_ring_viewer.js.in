'use strict';
const assert=require('assert'),fs=require('fs');const {fixture}=require('./viewer_fixture');
let groups=0;const opts={ring:true,audio:true,layout:true,fixedViewport:true,currentTime:0,bufferEnd:1};
async function test(name,options,check){const h=await fixture({...opts,...options});await check(h);groups++;console.log('PASS '+name);}
async function main(){
await test('exact handshake creates one fresh MSE and common timestamp offset',{},async h=>{await h.advance(100);assert.equal(h.pipelines.length,1);assert.equal(h.pipelines[0].sb.timestampOffset,-2);assert.equal(h.serverView().serverGeneration,1);assert(h.serverView().serverReady);assert.equal(h.view().seekWrites,0);assert.equal(h.requests.filter(r=>r.url.endsWith('/stream.mp4')).length,1);});
await test('initial readiness gates page input until acknowledged',{readyReject:true},async h=>{await h.advance(100);h.video.emit('click',{clientX:960,clientY:540});await h.advance(200);assert(!h.posts.some(p=>p.url.endsWith('/input')));assert.equal(h.nodes['state-title'].textContent,'Video connection paused');});
await test('input bound to current generation only',{},async h=>{await h.advance(100);h.video.emit('click',{clientX:960,clientY:540});await h.advance(150);const input=h.requests.find(r=>r.url.endsWith('/input'));assert.equal(input.opts.headers['X-R2D2-Media-Generation'],'1');assert.equal(input.opts.headers['X-R2D2-Media-Epoch'],'b'.repeat(32));});
await test('transport loss preserves browser and reconnects once after a bounded delay',{},async h=>{await h.advance(100);h.streams[0].fail();await h.advance(200);assert.equal(h.nodes['state-title'].textContent,'Video connection paused');assert.match(h.nodes['state-description'].textContent,/^Reconnecting video automatically/);assert(h.streams[0].cancelled);assert(!h.posts.some(p=>p.value.final));assert.equal(h.serverView().serverGeneration,1);await h.advance(1200);assert.equal(h.pipelines.length,2);assert.equal(h.serverView().serverGeneration,2);assert.equal(h.pipelines[1].sb.timestampOffset,-4);assert.equal(h.view().seekWrites,0);await h.advance(10000);assert.equal(h.serverView().serverGeneration,2);const m=h.posts.filter(p=>p.url.endsWith('/metrics')).at(-1).value;assert.equal(m.autoReconnects,1);assert.equal(m.cushionMs,800);assert(!h.posts.some(p=>p.value.final));});
await test('explicit reconnect cancels the pending automatic one',{},async h=>{await h.advance(100);h.streams[0].fail();await h.advance(200);h.nodes.retry.click();await h.advance(300);assert.equal(h.serverView().serverGeneration,2);await h.advance(10000);assert.equal(h.serverView().serverGeneration,2);assert.equal(h.posts.filter(p=>p.url.endsWith('/stream-open')).length,2);const m=h.posts.filter(p=>p.url.endsWith('/metrics')).at(-1).value;assert.equal(m.autoReconnects,0);});
await test('no input replay across explicit reconnect',{},async h=>{await h.advance(100);h.video.emit('click',{clientX:960,clientY:540});await h.advance(110);const count=h.posts.filter(p=>p.url.endsWith('/input')).length;h.streams[0].fail();await h.advance(150);h.video.emit('click',{clientX:960,clientY:540});h.nodes.retry.click();await h.advance(300);assert.equal(h.posts.filter(p=>p.url.endsWith('/input')).length,count);});
await test('changed source epoch never adopted', {foreignEpoch:true},async h=>{await h.advance(100);h.streams[0].fail();await h.advance(200);h.nodes.retry.click();await h.advance(300);assert.equal(h.serverView().serverGeneration,1);assert.equal(h.pipelines.length,1);assert.equal(h.nodes['state-title'].textContent,'Video connection paused');});
await test('lost open ACK is never replayed; retries are fresh generations with backoff',{lostOpen:true},async h=>{await h.advance(10000);const opens=h.posts.filter(p=>p.url.endsWith('/stream-open')).map(p=>p.value.generation);assert.deepEqual(opens,[0,1,2,3]);assert.equal(h.streams.length,0);assert.equal(h.nodes['state-title'].textContent,'Video connection paused');});
await test('malformed clock rejects before MSE or GET',{startNumerator:-1},async h=>{await h.advance(100);assert.equal(h.pipelines.length,0);assert.equal(h.streams.length,0);});
await test('fractional common clock used once for combined A/V',{startNumerator:25600,startDenominator:48000},async h=>{await h.advance(100);assert.equal(h.pipelines[0].sb.timestampOffset,-25600/48000);assert.equal(h.view().seekWrites,0);});
await test('receiver forward buffer bounds trigger detach not seek',{bufferEnd:9},async h=>{await h.advance(100);assert.equal(h.nodes['state-title'].textContent,'Video connection paused');assert(h.streams[0].cancelled);assert.equal(h.view().seekWrites,0);assert(!h.posts.some(p=>p.value.final));});
await test('stalled stream detaches after 15 s and reconnects once; heartbeat continues',{},async h=>{await h.advance(16300);assert.equal(h.nodes['state-title'].textContent,'Video connection paused');assert(h.streams[0].cancelled);assert.equal(h.serverView().serverGeneration,1);await h.advance(17300);assert.equal(h.serverView().serverGeneration,2);assert(!h.posts.some(p=>p.value.final));});
await test('Back returns controls and Close ends while reconnect paused',{bridge:true},async h=>{await h.advance(100);h.streams[0].fail();await h.advance(200);assert(!h.classes.has('page-mode'));let prevented=false;h.document.emit('keydown',{key:'Back',keyCode:461,preventDefault(){prevented=true;}});assert(!prevented);h.endButton.click();await h.advance(400);assert(h.posts.some(p=>p.url.endsWith('/end')));assert.equal(h.bridgeCalls.length,1);assert(h.posts.some(p=>p.value.final&&p.value.state==='finished'));});
await test('Close while first media open pending cannot reopen later',{playPending:true,bridge:true},async h=>{await h.advance(20);h.endButton.click();await h.advance(1000);assert(h.posts.some(p=>p.value.final));assert.equal(h.serverView().serverReady,false);assert.equal(h.bridgeCalls.length,1);});
await test('decoder failure detaches without whole-session shutdown',{},async h=>{await h.advance(100);h.video.error={code:3,message:'private secret'};h.video.emit('error');await h.advance(300);assert.equal(h.nodes['state-title'].textContent,'Video connection paused');assert(!h.posts.some(p=>p.value.final));assert(!JSON.stringify(h.posts).includes('private secret'));});
await test('pending play old promise cannot steal new pipeline', {playPending:true},async h=>{await h.advance(100);h.streams[0].fail();await h.advance(200);h.nodes.retry.click();await h.advance(400);assert.equal(h.pipelines.length,2);assert.equal(h.view().seekWrites,0);h.endButton.click();assert(h.posts.some(p=>p.value.final));});
await test('generation limit stops automatic reconnects and never silently rolls epoch',{},async h=>{let t=100;await h.advance(t);for(let i=1;i<32;i++){h.streams.at(-1).fail();await h.advance(t+=1500);}assert.equal(h.serverView().serverGeneration,32);assert.equal(h.pipelines.length,32);h.streams.at(-1).fail();await h.advance(t+=30000);h.nodes.retry.click();await h.advance(t+=2000);assert.equal(h.pipelines.length,32);assert.equal(h.posts.filter(p=>p.url.endsWith('/stream-open')).length,33);assert.equal(h.nodes['state-title'].textContent,'Video connection paused');});
// Production Trial configuration: the receipt rides the heartbeat, which continues while video is paused. Synthetic copy only.
await test('receipt card updates over a paused video without page input',{metricsReply:(b,n)=>({ok:true,voice:{v:1,seq:n<3?5:6,phase:'result',ageMs:0,tone:n<3?'sent':'done',word:n<3?'SENT':'DONE',headline:n<3?'Opening YouTube in the browser...':'Browser closed.',detail:'',badge:n<3?'sent':'confirmed',meter:null,meterMs:null,dwellMs:4000,mood:'verified',echo:null}})},async h=>{await h.advance(100);assert(!h.nodes['voice-card'].hidden);assert.equal(h.nodes['voice-card-title'].textContent,'Opening YouTube in the browser...');assert.equal(h.nodes['voice-card-word'].textContent,'Sent');h.streams[0].fail();await h.advance(200);assert.equal(h.nodes['state-title'].textContent,'Video connection paused');await h.advance(2100);assert(!h.nodes['voice-card'].hidden);assert.equal(h.nodes['voice-card-title'].textContent,'Browser closed.');assert.equal(h.nodes['voice-card-word'].textContent,'Confirmed');assert.equal(h.nodes['voice-card'].dataset.tone,'done');assert(!h.posts.some(p=>p.url.endsWith('/input')));assert(h.requests.filter(r=>r.url.endsWith('/metrics')).every(r=>r.opts.credentials==='omit'&&r.opts.redirect==='error'));});
const source=fs.readFileSync(__dirname+'/viewer.js','utf8');assert.equal([...source.matchAll(/\.currentTime\s*=(?!=)/g)].length,3);assert(!/playbackRate\s*=/.test(source));groups++;
console.log(JSON.stringify({groups}));}
main().catch(e=>{console.error(e);process.exitCode=1;});
