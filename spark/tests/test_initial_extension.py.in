"""Constructed initial AAC boundaries; generated bytes, no captured media."""
import io,unittest
import media_ring as m
from test_initial import native_init,native_pair
from test_sparse import ring,sparse_pair

class InitialExtension(unittest.TestCase):
 def parse(self,durations=(1248,1024),**kw):
  return m.parse_fragment(m.parse_init(*native_init()),*native_pair(durations,**kw),0,1,{})
 def test_native_private_video_prefix_then_audio1248_releases_exact_order(self):
  r=ring();first=sparse_pair(1,video=[256,256],sync=True);second=sparse_pair(2,video=[256],audio=[1248,1024],vd=512)
  r.append(*first);self.assertEqual((r.next_index,r.sequence,r.prior),(0,1,{}));self.assertEqual(dict(r.unpublished[0].decode_ends),{1:512});self.assertIsNone(r.read(m.Cursor(r.epoch,0)))
  with self.assertRaisesRegex(m.MediaError,'NO_ACCESS_POINT'):r.resume()
  try:r.append(*second)
  except m.MediaError as exc:self.fail('valid first audio mux boundary rejected: '+str(exc))
  self.assertEqual((r.next_index,r.sequence,r.prior),(2,3,{1:768,2:2272}));self.assertEqual(r.snapshot()['pendingBytes'],0);self.assertTrue(r.bootstrap_seen)
  cursor=r.resume().cursor;frag,cursor=r.read(cursor);self.assertTrue(frag.access_point);self.assertEqual((frag.moof,frag.mdat),first);frag,cursor=r.read(cursor);self.assertFalse(frag.access_point);self.assertEqual((frag.moof,frag.mdat),second);self.assertEqual(frag.track_spans,((1,512,768),(2,0,2272)));self.assertFalse(frag.initial_audio_trim or frag.terminal_audio_trim)
 def test_symmetric_bounded_policy_not1248_special_case(self):
  for duration in (1,431,815,1023,1024,1025,1247,1248,1249,1536,2047):
   with self.subTest(duration=duration):
    pair=native_pair((duration,1024))
    try:x=self.parse((duration,1024))
    except m.MediaError as exc:self.fail('bounded initial mux correction rejected: '+str(exc))
    self.assertEqual((x.moof,x.mdat),pair);self.assertEqual(dict(x.decode_ends)[2],duration+1024);self.assertEqual(x.initial_audio_trim,duration<1024);self.assertFalse(x.terminal_audio_trim)
 def test_zero2048_or_larger_initial_duration_stays_refused(self):
  for duration in (0,2048,2049,48000,2**32-1):
   with self.subTest(duration=duration),self.assertRaises(m.MediaError):self.parse((duration,1024))
  for duration in (2048,3072,4800):
   with self.subTest(short_duration=duration):
    x=m.parse_fragment(m.parse_init(*native_init()),*native_pair((duration,1024)),0,1,{},short_fragment=True)
    self.assertEqual(dict(x.decode_ends)[2],duration+1024)
  for duration in (0,4801,48000):
   with self.subTest(short_refused=duration),self.assertRaises(m.MediaError):
    m.parse_fragment(m.parse_init(*native_init()),*native_pair((duration,1024)),0,1,{},short_fragment=True)
 def test_nonzero_original_dts_or_prior_audio_never_uses_boundary(self):
  with self.assertRaisesRegex(m.MediaError,'AUDIO_SAMPLE'):self.parse(ad=1)
  for prior in ({2:0},{1:0,2:0}):
   with self.assertRaisesRegex(m.MediaError,'AUDIO_SAMPLE'):m.parse_fragment(m.parse_init(*native_init()),*native_pair(),0,1,prior)
  with self.assertRaisesRegex(m.MediaError,'AUDIO_SAMPLE'):m.parse_fragment(m.parse_init(*native_init()),*native_pair((1248,1024)),0,1,{2:0})
 def test_nonfirst1248_and_nonexplicit_extension_are_refused(self):
  for durations in ((1024,1248),(1248,1248),(1248,1025),(1024,1248,1024)):
   with self.subTest(durations=durations),self.assertRaisesRegex(m.MediaError,'AUDIO_SAMPLE'):self.parse(durations)
  # A single first sample whose 1248 duration is carried by the tfhd default is
  # the same bounded startup extension, admitted without rewriting bytes.
  x=self.parse((1248,),explicit=False,default=1248);self.assertEqual(dict(x.decode_ends)[2],1248);self.assertFalse(x.initial_audio_trim or x.terminal_audio_trim)
  with self.assertRaisesRegex(m.MediaError,'AUDIO_SAMPLE'):self.parse((1248,1248),explicit=False,default=1248)
 def test_bad_audio_flags_cts_and_payload_accounting_remain_refused(self):
  for kw in ({'aflags':0x01010000},{'cts':1}):
   with self.assertRaises(m.MediaError):self.parse(**kw)
  a,b=native_pair((1248,1024))
  with self.assertRaises(m.MediaError):m.parse_fragment(m.parse_init(*native_init()),a,b+b'x',0,1,{})
 def test_one_explicit_initial_extension_is_not_terminal_authority(self):
  r=ring();first=native_pair((1248,));r.append(*first);self.assertEqual(r.prior,{1:512,2:1248});self.assertFalse(r.ended);r.append(*native_pair((1024,1024),seq=2,ad=1248,vd=512));self.assertEqual(r.prior,{1:1024,2:3296})
 def test_midstream_extension_preserves_frontier_and_clocks_on_refusal(self):
  r=ring();r.append(*native_pair((1248,1024)));before=(r.next_index,r.prior.copy(),r.bytes,r.count)
  with self.assertRaisesRegex(m.MediaError,'AUDIO_SAMPLE'):r.append(*native_pair((1248,1024),seq=2,ad=2272,vd=512))
  self.assertEqual((r.next_index,r.prior,r.bytes,r.count),before)
 def test_extension_does_not_hide_terminal_trim_or_clean_eof_requirement(self):
  pair=native_pair((1248,256));r=ring()
  with self.assertRaisesRegex(m.MediaError,'AUDIO_SAMPLE'):r.append(*pair)
  raw=b''.join(native_init()+pair);r=m.MediaRing('a'*32);stream=io.BytesIO(raw);seen=[]
  def read(n):
   if stream.tell()==len(raw):seen.append((r.next_index,r.ended,r.snapshot()['pendingBytes']))
   return stream.read(n)
  p=m.Producer(r,read);p.step();p.step();self.assertTrue(seen and all(index==0 and ended is False and pending>0 for index,ended,pending in seen));self.assertTrue(r.ended and r.terminal_audio_trim);self.assertFalse(r.initial_audio_trim)
  raw=b''.join(native_init()+pair+native_pair((1024,),seq=2,ad=1504,vd=512));r=m.MediaRing('a'*32);p=m.Producer(r,io.BytesIO(raw).read);p.step()
  with self.assertRaisesRegex(m.MediaError,'TERMINAL_AUDIO_NOT_LAST'):p.step()
  self.assertEqual((r.next_index,r.prior,r.count),(0,{},0));self.assertFalse(r.ended)
if __name__=='__main__':unittest.main()
