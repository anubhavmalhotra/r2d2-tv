async function test(n,o,f){const h=await fixture(o);await f(h);groups++;console.log('PASS '+n);}
async function main(){
 await require('./test_media_cleanup.js').run();
 const idleVoice={schema:1,available:true,state:'idle',request:null};
 const activeVoice=(action,body)=>action==='get'?idleVoice:{schema:1,available:true,state:action==='start'?'listening':action==='release'?'accepted':'refused',request:body.request};
 await test('second mic click while start POST is pending preserves start until listening',{toolbar:true,voiceReply:activeVoice,voiceDelay:100},async h=>{await h.advance(100);h.nodes.mic.click();await h.advance(210);assert.equal(h.nodes['voice-label'].textContent,'Preparing microphone...');const start=h.requests.find(p=>p.opts.method==='POST'&&p.url.endsWith('/voice'));assert(start);assert.equal(start.opts.signal.aborted,false);h.nodes.mic.click();h.nodes.mic.click();assert.equal(start.opts.signal.aborted,false);assert.deepEqual(h.posts.filter(p=>p.url.endsWith('/voice')).map(p=>p.value.action),['start']);await h.advance(320);assert(h.nodes['voice-label'].textContent.startsWith('Listening'));h.nodes.mic.click();await h.advance(440);assert.equal(h.nodes['voice-label'].textContent,'Voice command accepted.');assert.deepEqual(h.posts.filter(p=>p.url.endsWith('/voice')).map(p=>p.value.action),['start','release']);});
 await test('preparing acknowledgement ignores repeated mic clicks but later listening can release',{toolbar:true,voiceReply:(()=>{let id=null;return(action,body)=>{if(action==='start'){id=body.request;return{schema:1,available:true,state:'preparing',request:id};}if(action==='get')return id?{schema:1,available:true,state:'listening',request:id}:idleVoice;return{schema:1,available:true,state:action==='release'?'accepted':'refused',request:id};};})()},async h=>{await h.advance(100);h.nodes.mic.click();await h.advance(200);assert.equal(h.nodes['voice-label'].textContent,'Preparing microphone...');h.nodes.mic.click();h.nodes.mic.click();assert.deepEqual(h.posts.filter(p=>p.url.endsWith('/voice')).map(p=>p.value.action),['start']);assert.equal(h.nodes['cancel-voice'].textContent,'Cancel');await h.advance(700);assert(h.nodes['voice-label'].textContent.startsWith('Listening'));h.nodes.mic.click();await h.advance(800);assert.equal(h.nodes['voice-label'].textContent,'Voice command accepted.');assert.deepEqual(h.posts.filter(p=>p.url.endsWith('/voice')).map(p=>p.value.action),['start','release']);});
 await test('Cancel remains available while native capture is preparing',{toolbar:true,voiceReply:(action,body)=>action==='get'?idleVoice:{schema:1,available:true,state:action==='start'?'preparing':'refused',request:body.request}},async h=>{await h.advance(100);h.nodes.mic.click();await h.advance(200);h.nodes.mic.click();h.document.emit('keydown',{key:'ArrowDown',target:h.nodes.mic,preventDefault(){}});assert.equal(h.document.activeElement,h.nodes['cancel-voice']);h.document.emit('keydown',{key:'Enter',target:h.nodes['cancel-voice'],preventDefault(){}});await h.advance(300);assert(h.nodes['voice-status'].hidden);assert.equal(h.document.activeElement,h.nodes.mic);assert.deepEqual(h.posts.filter(p=>p.url.endsWith('/voice')).map(p=>p.value.action),['start','cancel']);});
 await test('unknown terminal labels Dismiss and keyboard dismissal never resends cleanup',{toolbar:true,voiceReply:(action,body)=>action==='get'?idleVoice:{schema:1,available:false,state:'unknown',request:body.request}},async h=>{await h.advance(100);h.nodes.mic.click();await h.advance(200);assert(h.nodes['voice-label'].textContent.includes('could not be confirmed'));assert.equal(h.nodes['cancel-voice'].textContent,'Dismiss');h.document.emit('keydown',{key:'ArrowDown',target:h.nodes.mic,preventDefault(){}});h.document.emit('keydown',{key:'Enter',target:h.nodes['cancel-voice'],preventDefault(){}});await h.advance(300);assert(h.nodes['voice-status'].hidden);assert.equal(h.document.activeElement,h.nodes.mic);assert.deepEqual(h.posts.filter(p=>p.url.endsWith('/voice')).map(p=>p.value.action),['start','cancel']);});
 await test('release during a pending status read does not let the aborted read cancel capture',{toolbar:true,voiceDelay:100,voiceReply:activeVoice},async h=>{await h.advance(100);h.nodes.mic.click();await h.advance(850);assert(h.nodes['voice-label'].textContent.startsWith('Listening'));h.nodes.mic.click();await h.advance(1000);assert.equal(h.nodes['voice-label'].textContent,'Voice command accepted.');assert.deepEqual(h.posts.filter(p=>p.url.endsWith('/voice')).map(p=>p.value.action),['start','release']);});
 await test('accepted without an owned release is refused instead of claimed as success',{toolbar:true,voiceReply:(action,body)=>action==='get'?idleVoice:{schema:1,available:true,state:'accepted',request:body.request}},async h=>{await h.advance(100);h.nodes.mic.click();await h.advance(200);assert(h.nodes['voice-label'].textContent.includes('could not be confirmed'));assert.deepEqual(h.posts.filter(p=>p.url.endsWith('/voice')).map(p=>p.value.action),['start','cancel']);});
 await test('capture observation has a finite limit and no automatic retry',{toolbar:true,continual:true,voiceReply:(()=>{let id=null;return(action,body)=>{if(action==='start')id=body.request;return id?{schema:1,available:true,state:action==='cancel'?'refused':'listening',request:id}:idleVoice;};})()},async h=>{await h.advance(100);h.nodes.mic.click();await h.advance(200);assert(h.nodes['voice-label'].textContent.startsWith('Listening'));await h.advance(212200);assert(h.nodes['voice-label'].textContent.includes('timed out'));assert.equal(h.nodes['cancel-voice'].textContent,'Dismiss');assert.deepEqual(h.posts.filter(p=>p.url.endsWith('/voice')).map(p=>p.value.action),['start','cancel']);const reads=h.requests.filter(p=>p.url.endsWith('/voice')).length;await h.advance(214000);assert.equal(h.requests.filter(p=>p.url.endsWith('/voice')).length,reads);});
 await test('new active tab preserves address editing focus without scrolling the viewer',{toolbar:true,tabs:true},async h=>{await h.advance(100);h.nodes['new-tab'].click();await h.advance(800);assert.equal(h.document.activeElement,h.address);assert.equal(h.address.readOnly,false);const active=h.tabButtons().find(b=>b.dataset.tabId===h.tabs.active&&b.dataset.tabAction==='switch');assert.equal(active.scrollCalls.length,0);assert.equal(h.tabs.tabs.length,2);});
 await test('Go button uses the existing explicit submit and preserves Google q-only URL',{toolbar:true},async h=>{await h.advance(100);h.address.value='compact browser';h.nodes.go.click();await h.advance(200);assert.equal(h.posts.filter(p=>p.url.endsWith('/navigate')).length,1);assert.equal(h.posts.find(p=>p.url.endsWith('/navigate')).value.url,'https://www.google.com/search?q=compact%20browser');});
