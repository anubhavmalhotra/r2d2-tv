 await test('invalid URLs and typing do not become remote input',{},async h=>{await h.advance(100);for(const u of ['http://example.com','javascript:alert(1)','file:///tmp/a','https://u:p@example.com','https://example.com/\\bad','https://example.com/'+'a'.repeat(1600)]){h.address.value=u;h.form.emit('submit',{preventDefault(){}});assert.equal(h.address.value,u);}h.document.emit('keydown',{key:'Enter',target:h.address,preventDefault(){}});await h.advance(200);assert(!h.posts.some(r=>r.url.endsWith('/navigate')||r.url.endsWith('/input')));});
 await test('Close browser clears address, preserves final post and releases media',{},async h=>{await h.advance(100);h.address.value='private-unsent';h.endButton.emit('click');await h.advance(200);assert.equal(h.address.value,'');assert(h.metric().final);assert(h.view().readerCancelled&&h.view().revoked);const end=h.requests.filter(r=>r.url.endsWith('/end'));assert.equal(end.length,1);assert.equal(end[0].opts.signal.aborted,false);});
 await test('actual page unload clears unsent URL and stops',{},async h=>{await h.advance(100);h.address.value='private-unsent';h.window.emit('pagehide');await h.advance(200);assert.equal(h.address.value,'');assert.equal(h.metric().error,'PAGE_HIDDEN');assert(h.view().readerCancelled);});
 await test('toolbar D-pad navigation does not send page input; Down hands off and Back returns',{toolbar:true},async h=>{await h.advance(100);assert.equal(h.document.activeElement,h.address);h.document.emit('keydown',{key:'ArrowRight',target:h.address,preventDefault(){}});assert.equal(h.document.activeElement,h.nodes.go);h.document.emit('keydown',{key:'ArrowDown',target:h.nodes.go,preventDefault(){}});assert.equal(h.document.activeElement,h.nodes.page);h.document.emit('keydown',{key:'Enter',target:h.nodes.page,preventDefault(){}});h.document.emit('keydown',{keyCode:461,target:h.nodes.page,preventDefault(){}});assert.equal(h.document.activeElement,h.address);await h.advance(300);assert.deepEqual(h.posts.filter(x=>x.url.endsWith('/input')).map(x=>x.value.key),['Enter']);});
 await test('page forwards all four arrows; first Back returns toolbar and second remains native',{},async h=>{await h.advance(100);for(const key of ['ArrowLeft','ArrowUp','ArrowRight','ArrowDown'])h.document.emit('keydown',{key,target:h.nodes.page,preventDefault(){}});let prevented=0;h.document.emit('keydown',{keyCode:461,target:h.nodes.page,preventDefault(){prevented++;}});assert.equal(prevented,1);assert.equal(h.document.activeElement,h.address);h.document.emit('keydown',{keyCode:461,repeat:true,target:h.address,preventDefault(){prevented++;}});assert.equal(prevented,2);h.document.emit('keyup',{keyCode:461});h.document.emit('keydown',{keyCode:461,target:h.address,preventDefault(){assert.fail('second Back must stay native');}});await h.advance(500);assert.deepEqual(h.posts.filter(x=>x.url.endsWith('/input')).map(x=>x.value.key),['ArrowLeft','ArrowUp','ArrowRight','ArrowDown']);});
 await test('OK edits address and HTTPS is added without accepting unsafe schemes',{toolbar:true},async h=>{await h.advance(100);h.document.emit('keydown',{keyCode:13,target:h.address,preventDefault(){}});assert.equal(h.address.readOnly,false);h.address.value='youtube.com/watch?v=synthetic';h.document.emit('keydown',{keyCode:13,target:h.address,preventDefault(){}});await h.advance(200);assert.equal(h.posts.find(x=>x.url.endsWith('/navigate')).value.url,'https://youtube.com/watch?v=synthetic');assert.equal(h.document.activeElement,h.nodes.page);assert.equal(h.address.readOnly,true);assert(!JSON.stringify(h.metric()).includes('synthetic'));});
 await test('Google receives only a submitted query; typing and metrics carry no search text',{toolbar:true},async h=>{
   await h.advance(100);const query='café & cats # kittens? 🐈';h.address.click();
   for(const text of ['c','café',query]){h.address.value=text;h.address.emit('input',{});await h.advance(200+text.length*100);}
   assert(!h.posts.some(x=>x.url.endsWith('/navigate')));
   assert(!JSON.stringify(h.requests).includes('caf'));
   h.form.emit('submit',{preventDefault(){}});await h.advance(5000);
   const nav=h.posts.filter(x=>x.url.endsWith('/navigate'));assert.equal(nav.length,1);
   const u=new URL(nav[0].value.url);assert.equal(u.origin,'https://www.google.com');assert.equal(u.pathname,'/search');
   assert.deepEqual([...u.searchParams.keys()],['q']);assert.equal(u.searchParams.get('q'),query);assert.equal(u.hash,'');
   assert(!JSON.stringify(h.posts.filter(x=>x.url.endsWith('/metrics'))).includes('caf'));
 });
 await test('bare domain with port and search phrase normalize only on explicit submit',{toolbar:true},async h=>{await h.advance(100);const cases=[['example.com:8443/path','https://example.com:8443/path'],['youtube.com','https://youtube.com/'],['funny cat videos','https://www.google.com/search?q=funny%20cat%20videos']];for(let n=0;n<cases.length;n++){const pair=cases[n];h.address.value=pair[0];const before=h.posts.filter(x=>x.url.endsWith('/navigate')).length;assert.equal(before,n);h.form.emit('submit',{preventDefault(){}});await h.advance(200+n*100);assert.equal(h.posts.filter(x=>x.url.endsWith('/navigate')).at(-1).value.url,pair[1]);}assert(!JSON.stringify(h.posts.filter(x=>x.url.endsWith('/metrics'))).includes('cat'));});
 await test('editing preserves arrows and supports Escape without remote input',{toolbar:true},async h=>{await h.advance(100);h.address.click();for(const key of ['ArrowLeft','ArrowRight','ArrowUp','ArrowDown'])h.document.emit('keydown',{key,target:h.address,preventDefault(){assert.fail('editing arrow swallowed');}});h.document.emit('keydown',{key:'Escape',target:h.address,preventDefault(){}});assert.equal(h.address.readOnly,true);await h.advance(200);assert(!h.posts.some(x=>x.url.endsWith('/input')));});
 await test('history actions use exact enum, clear stale address, and do not dispatch page input',{toolbar:true},async h=>{await h.advance(100);for(const action of ['back','forward','reload']){h.address.value='https://example.com/private';h.nodes[action].click();await h.advance(150+h.posts.length);assert.equal(h.address.value,'');}const requests=h.posts.filter(x=>x.url.endsWith('/history')).map(x=>x.value);assert.deepEqual(JSON.parse(JSON.stringify(requests)),[{action:'back'},{action:'forward'},{action:'reload'}]);assert(!h.posts.some(x=>x.url.endsWith('/input')));});
 await test('unwired history controls are disabled and issue no pretend action',{toolbar:true,history:false},async h=>{await h.advance(100);for(const action of ['back','forward','reload']){assert.equal(h.nodes[action].disabled,true);h.nodes[action].click();}await h.advance(200);assert(!h.posts.some(x=>x.url.endsWith('/history')));});
 await test('letterboxed inset video maps its actual picture and ignores bars or toolbar',{rect:{left:0,top:100,width:1920,height:980}},async h=>{await h.advance(100);h.video.emit('click',{clientX:10,clientY:600});h.video.emit('click',{clientX:960,clientY:50});h.video.emit('click',{clientX:960,clientY:590});await h.advance(300);const inputs=h.posts.filter(x=>x.url.endsWith('/input'));assert.equal(inputs.length,1);assert.equal(inputs[0].value.x,0.5);assert.equal(inputs[0].value.y,0.5);});
 await test('page interaction clears last-entered URL and pointer toolbar focus restores local navigation',{},async h=>{await h.advance(100);h.address.value='https://example.com/last-entry';h.video.emit('click',{clientX:960,clientY:540});assert.equal(h.address.value,'');h.address.value='https://example.com/another-entry';h.document.emit('keydown',{key:'Enter',target:h.nodes.page,preventDefault(){}});assert.equal(h.address.value,'');h.nodes.back.focus();h.nodes.toolbar.emit('focusin');h.document.emit('keydown',{key:'ArrowRight',target:h.nodes.back,preventDefault(){}});assert.equal(h.document.activeElement,h.nodes.forward);await h.advance(500);assert.equal(h.posts.filter(x=>x.url.endsWith('/input')).length,2);});
 await test('playing removes loading overlay; friendly failure contains no diagnostic codes',{toolbar:true},async h=>{await h.advance(100);h.video.emit('playing');assert.equal(h.nodes['state-panel'].hidden,true);h.video.emit('error');assert.equal(h.nodes['state-panel'].hidden,false);assert.equal(h.nodes['state-title'].textContent,'Your browser connection stopped');assert(!h.nodes['state-description'].textContent.includes('VIDEO_ERROR'));assert.equal(h.address.value,'');assert.equal(h.endButton.disabled,true);});
 await test('tabs initial read is exact and does not steal address focus',{tabs:true,toolbar:true},async h=>{await h.advance(100);assert.equal(h.document.activeElement,h.address);assert.equal(h.tabButtons().length,2);assert.equal(h.nodes['new-tab'].disabled,false);assert.equal(h.tabButtons()[0].textContent,'New tab');assert.equal(h.tabGets(),1);assert(!h.posts.some(p=>p.url.endsWith('/tabs')));});
 await test('idle labels preserve focused tab by ID without rebuilding unchanged controls',{tabs:true,toolbar:true,continual:true},async h=>{await h.advance(100);h.document.emit('keydown',{key:'ArrowDown',preventDefault(){}});const first=h.document.activeElement;await h.advance(2100);assert.equal(h.document.activeElement,first);assert.equal(h.tabButtons()[0],first);h.tabs.tabs[0].label='youtube.com';await h.advance(4100);assert.equal(h.document.activeElement.dataset.tabId,first.dataset.tabId);assert.equal(h.document.activeElement.textContent,'youtube.com');h.address.click();h.address.value='unsent private phrase';await h.advance(6100);assert.equal(h.document.activeElement,h.address);assert.equal(h.address.value,'unsent private phrase');});
 await test('tab strip D-pad moves select close New and hands all arrows back to page',{tabs:true,toolbar:true},async h=>{await h.advance(100);const key=k=>h.document.emit('keydown',{key:k,preventDefault(){}});key('ArrowDown');assert.equal(h.document.activeElement,h.tabButtons()[0]);key('ArrowRight');assert.equal(h.document.activeElement,h.tabButtons()[1]);key('ArrowRight');assert.equal(h.document.activeElement,h.nodes['new-tab']);key('ArrowUp');assert.equal(h.document.activeElement,h.address);key('ArrowDown');key('ArrowDown');assert.equal(h.document.activeElement,h.nodes.page);key('ArrowUp');key('Escape');assert.equal(h.document.activeElement,h.address);await h.advance(200);assert.equal(h.posts.filter(p=>p.url.endsWith('/input')).at(-1).value.key,'ArrowUp');});
 await test('new tab POST acceptance waits for revision and is never replayed',{tabs:true,toolbar:true,tabDelay:2200,continual:true},async h=>{await h.advance(100);h.address.value='secret';h.nodes['new-tab'].click();await h.advance(1900);assert.equal(h.address.value,'');assert.equal(h.nodes['new-tab'].disabled,true);assert.equal(h.nodes.go.disabled,true);h.nodes['new-tab'].click();h.video.emit('click',{clientX:960,clientY:540});h.nodes['browse-page'].click();h.document.emit('keydown',{key:'Enter',preventDefault(){}});await h.advance(3000);assert.equal(h.posts.filter(p=>p.url.endsWith('/tabs')).length,1);assert.equal(h.posts.filter(p=>p.url.endsWith('/input')).length,0);assert.equal(h.tabButtons().length,4);assert.equal(h.document.activeElement,h.address);assert.equal(h.address.readOnly,false);assert.equal(h.nodes.go.disabled,false);});
 await test('same-active switch and last-tab reset still require revision',{tabs:true,toolbar:true,tabDelay:900},async h=>{await h.advance(100);h.tabButtons()[0].click();await h.advance(800);assert.equal(h.nodes['new-tab'].disabled,true);await h.advance(1200);assert.equal(h.nodes['new-tab'].disabled,false);assert.equal(h.tabs.revision,1);h.tabButtons()[1].click();await h.advance(1600);assert.equal(h.nodes['new-tab'].disabled,true);await h.advance(2500);assert.equal(h.tabs.revision,2);assert.equal(h.tabButtons().length,2);assert.deepEqual(h.posts.filter(p=>p.url.endsWith('/tabs')).map(p=>p.value.action),['switch','close']);});
 await test('max eight tabs disables only New and known close carries exact opaque ID',{tabs:true,toolbar:true,tabsState:{tabs:Array.from({length:8},(_,n)=>({id:String(n+1).repeat(16),label:'example'+n+'.com'})),active:'1'.repeat(16),revision:0}},async h=>{await h.advance(100);assert.equal(h.nodes['new-tab'].disabled,true);h.nodes['new-tab'].click();h.tabButtons()[3].click();await h.advance(800);assert.equal(h.tabs.tabs.length,7);assert.equal(h.nodes['new-tab'].disabled,false);const post=h.posts.find(p=>p.url.endsWith('/tabs'));assert.deepEqual(JSON.parse(JSON.stringify(post.value)),{action:'close',id:'2'.repeat(16)});});
 await test('ambiguous tab command remains locked with no POST retry after observation deadline',{tabs:true,toolbar:true,noTabCommit:true,continual:true},async h=>{await h.advance(100);h.nodes['new-tab'].click();await h.advance(15000);assert.equal(h.nodes['new-tab'].disabled,true);assert.equal(h.nodes.go.disabled,true);assert.equal(h.posts.filter(p=>p.url.endsWith('/tabs')).length,1);assert(h.tabGets()<40);h.tabs.revision=1;await h.advance(16100);assert.equal(h.nodes['new-tab'].disabled,false);});
 await test('authoritative409 unlocks browser controls after fresh unchanged state without replay',{tabs:true,toolbar:true,tabPostStatus:409},async h=>{await h.advance(100);h.nodes['new-tab'].click();await h.advance(500);assert.equal(h.tabs.revision,0);assert.equal(h.nodes['new-tab'].disabled,false);assert.equal(h.nodes.go.disabled,false);assert.equal(h.nodes.back.disabled,false);assert.equal(h.posts.filter(p=>p.url.endsWith('/tabs')).length,1);assert(h.tabGets()>=2);assert.equal(h.nodes['tabs-status'].textContent,'');assert(h.status.textContent.includes('busy'));await h.advance(3000);assert.equal(h.posts.filter(p=>p.url.endsWith('/tabs')).length,1);});
 for(const [label,options] of [['lost response',{tabPostStall:true}],['server error',{tabPostStatus:500}],['foreign409',{tabPostStatus:409,tabPostUrl:'http://foreign/tabs'}]])await test('uncertain tab outcome stays pending without replay: '+label,{tabs:true,toolbar:true,continual:true,...options},async h=>{await h.advance(100);h.nodes['new-tab'].click();await h.advance(15000);assert.equal(h.nodes['new-tab'].disabled,true);assert.equal(h.nodes.go.disabled,true);assert.equal(h.posts.filter(p=>p.url.endsWith('/tabs')).length,1);});
 const validTabs={tabs:[{id:'1'.repeat(16),label:'New tab'}],active:'1'.repeat(16),revision:0};
 const invalidTabs=[null,{...validTabs,revision:true},{...validTabs,revision:Number.MAX_SAFE_INTEGER+1},{...validTabs,revision:-1},{...validTabs,extra:true},{...validTabs,active:'2'.repeat(16)},{...validTabs,tabs:[]},{...validTabs,tabs:Array(9).fill(validTabs.tabs[0])},{...validTabs,tabs:[validTabs.tabs[0],validTabs.tabs[0]]},{...validTabs,tabs:[{id:'A'.repeat(16),label:'New tab'}]},{...validTabs,tabs:[{id:'1'.repeat(16),label:'https://secret/path'}]},{...validTabs,tabs:[{id:'1'.repeat(16),label:'x'.repeat(65)}]},{...validTabs,tabs:[{id:'1'.repeat(16),label:'a',url:'private'}]}];
 for(let n=0;n<invalidTabs.length;n++)await test('invalid exact tabs schema '+n,{tabs:true,toolbar:true,tabsBody:JSON.stringify(invalidTabs[n])},async h=>{await h.advance(100);assert.equal(h.tabButtons().length,0);assert.equal(h.nodes['new-tab'].disabled,true);assert.equal(h.nodes['tabs-status'].textContent,'Tabs unavailable');});
 for(const [label,opts] of [['oversized',{tabsBody:' '.repeat(2049)}],['nonASCII',{tabsBody:'é'}],['redirected',{tabsUrl:'http://foreign/tabs'}],['status',{tabsStatus:409}]])await test('tabs body refuses '+label,{tabs:true,toolbar:true,...opts},async h=>{await h.advance(100);assert.equal(h.nodes['new-tab'].disabled,true);assert.equal(h.tabButtons().length,0);});
 await test('periodic GET coalesces stalled read and close drops labels, URL and future refresh',{tabs:true,toolbar:true,tabsStall:true,continual:true},async h=>{await h.advance(5000);assert.equal(h.tabGets(),3);h.address.value='secret';h.endButton.click();const count=h.tabGets();await h.advance(15000);assert.equal(h.tabGets(),count);assert.equal(h.tabButtons().length,0);assert.equal(h.address.value,'');assert.equal(h.nodes.tabstrip.hidden,true);});
 await test('revision regression or same-revision identity drift disables controls',{tabs:true,toolbar:true,continual:true,tabsState:{...validTabs,revision:2}},async h=>{await h.advance(100);h.tabs.revision=1;await h.advance(2100);assert.equal(h.nodes['new-tab'].disabled,true);h.tabs.revision=2;h.tabs.tabs.push({id:'2'.repeat(16),label:'New tab'});await h.advance(4100);assert.equal(h.nodes['new-tab'].disabled,true);assert.equal(h.tabButtons().length,2);});
 for(const revision of [64,65])await test('long session can change tabs at revision '+revision,{tabs:true,toolbar:true,continual:true,tabsState:{...validTabs,revision}},async h=>{await h.advance(100);assert.equal(h.nodes['new-tab'].disabled,false);h.nodes['new-tab'].click();await h.advance(500);assert.equal(h.tabs.revision,revision+1);assert.equal(h.posts.filter(p=>p.url.endsWith('/tabs')).length,1);});
 await test('tab integer limit preserves Close browser and page controls',{tabs:true,toolbar:true,tabsState:{...validTabs,revision:Number.MAX_SAFE_INTEGER}},async h=>{await h.advance(100);assert.equal(h.nodes['new-tab'].disabled,true);assert(h.tabButtons().every(b=>b.disabled));assert.equal(h.endButton.disabled,false);assert.equal(h.nodes['browse-page'].disabled,false);assert.equal(h.posts.filter(p=>p.url.endsWith('/tabs')).length,0);});


 await test('direct field overlay uses the captured normalized rect without an extra DPR factor',{text:true},async h=>{await h.advance(100);h.video.emit('click',{clientX:960,clientY:540});await h.advance(300);const field=h.nodes['editor-input'];assert.equal(h.nodes['editor-form'].hidden,false);assert.equal(field.readOnly,false);assert.equal(h.document.activeElement,field);assert.equal(h.nodes['editor-form'].style.left,'192px');assert.equal(h.nodes['editor-form'].style.top,'216px');assert.equal(h.nodes['editor-form'].style.width,'768px');assert.equal(field.value,'');});
 await test('coalesced native edits send one exact whole value including selection',{text:true},async h=>{await h.advance(100);h.video.emit('click',{clientX:960,clientY:540});await h.advance(300);const f=h.nodes['editor-input'];f.value='a';f.emit('input');f.value='abc';f.emit('input');f.value='aXbc';f.setSelectionRange(2,2,'none');f.emit('input');await h.advance(1000);const e=h.posts.filter(p=>p.url.endsWith('/editor'));assert.equal(e.length,1);assert.equal(e[0].value.action,'replace');assert.equal(e[0].value.value,'aXbc');assert.equal(e[0].value.selectionStart,2);assert.equal(e[0].value.seq,1);assert.equal(f.value,'aXbc');assert(!JSON.stringify(h.metric()).includes('aXbc'));});
 await test('empty native field value clears the whole remote field',{text:true,textState:{state:'editable',kind:'text',multiline:false,maxLength:2048,focusId:'f'.repeat(16),fieldId:'d'.repeat(16),value:'old value',selectionStart:9,selectionEnd:9,selectionDirection:'none',rect:{x:.1,y:.2,width:.4,height:.05},revision:0,nextSeq:1,edit:null}},async h=>{await h.advance(100);h.video.emit('click',{clientX:960,clientY:540});await h.advance(300);const f=h.nodes['editor-input'];assert.equal(f.value,'old value');f.value='';f.setSelectionRange(0,0,'none');f.emit('input');await h.advance(1000);assert.equal(h.posts.find(p=>p.url.endsWith('/editor')).value.value,'');});
 await test('latest dirty local draft survives ACK and is sent only after fresh same-field completion',{text:true,textDelay:1000,continual:true},async h=>{await h.advance(100);h.video.emit('click',{clientX:960,clientY:540});await h.advance(300);const f=h.nodes['editor-input'];f.value='first';f.emit('input');await h.advance(600);f.value='latest';f.emit('input');await h.advance(1000);assert.equal(h.posts.filter(p=>p.url.endsWith('/editor')).length,1);assert.equal(f.value,'latest');await h.advance(3000);const edits=h.posts.filter(p=>p.url.endsWith('/editor'));assert.equal(edits.length,2);assert.equal(edits[1].value.value,'latest');assert.equal(edits[1].value.seq,2);assert.equal(f.value,'latest');});
 await test('real native form Go works while keyboard visible but raw remote OK does not submit',{text:true,toolbar:true},async h=>{await h.advance(100);h.address.click();h.address.value='youtube.com';h.document.emit('keyboardStateChange',{detail:{visibility:true}});h.document.emit('keydown',{key:'Enter',keyCode:13,target:h.address,preventDefault(){assert.fail('IME OK intercepted');}});await h.advance(200);assert(!h.posts.some(p=>p.url.endsWith('/navigate')));h.form.emit('submit',{preventDefault(){}});await h.advance(400);assert.equal(h.posts.filter(p=>p.url.endsWith('/navigate')).length,1);assert.equal(h.posts.find(p=>p.url.endsWith('/navigate')).value.url,'https://youtube.com/');});
 await test('native field Return commits latest value once and closes after applied despite focus loss',{text:true,submitLeaves:true},async h=>{await h.advance(100);h.video.emit('click',{clientX:960,clientY:540});await h.advance(300);const f=h.nodes['editor-input'];f.value='search query';f.emit('input');h.document.emit('keyboardStateChange',{detail:{visibility:true}});h.nodes['editor-form'].emit('submit',{preventDefault(){}});await h.advance(1000);const edits=h.posts.filter(p=>p.url.endsWith('/editor'));assert.equal(edits.length,1);assert.equal(edits[0].value.action,'replace-enter');assert.equal(edits[0].value.value,'search query');assert.equal(h.nodes['editor-form'].hidden,true);assert.equal(f.value,'');});
