 await test('late fullscreen observation cannot hide controls explicitly opened by Back',{fixedViewport:true,layout:true,text:true,continual:true},async h=>{await h.advance(100);h.document.emit('keydown',{keyCode:461,preventDefault(){}});assert.equal(h.document.activeElement,h.address);h.presentation.fullscreen=true;h.presentation.revision=1;await h.advance(1400);assert(h.presentation.fullscreen);assert(!h.classes.has('remote-fullscreen'));assert(!h.classes.has('page-mode'));assert.equal(h.document.activeElement,h.address);h.nodes['browse-page'].click();assert(h.classes.has('remote-fullscreen'));});
 await test('fullscreen transport error leaves a focused working Home recovery button',{fixedViewport:true,layout:true,text:true,bridge:true,continual:true},async h=>{await h.advance(100);h.presentation.fullscreen=true;h.presentation.revision=1;await h.advance(1100);h.video.emit('error');assert(!h.classes.has('remote-fullscreen'));assert(!h.classes.has('page-mode'));assert.equal(h.nodes.retry.hidden,false);assert.equal(h.nodes.retry.disabled,false);assert.equal(h.document.activeElement,h.nodes.retry);assert.equal(h.nodes.retry.textContent,'Return to R2D2');h.nodes.retry.click();h.nodes.retry.click();await h.advance(1600);assert.equal(h.bridgeCalls.length,1);assert.equal(h.bridgeView.closed,1);assert.equal(h.posts.filter(p=>p.url.endsWith('/metrics')&&p.value.final).length,1);});
 for(const event of [{keyCode:461},{key:'Escape'},{key:'Enter'}])await test('closed session remote action returns to Home '+JSON.stringify(event),{bridge:true,continual:true},async h=>{await h.advance(100);h.video.emit('error');h.document.emit('keydown',{...event,preventDefault(){}});h.document.emit('keydown',{...event,repeat:true,preventDefault(){}});await h.advance(600);assert.equal(h.bridgeCalls.length,1);assert.equal(h.bridgeView.closed,1);assert(!h.posts.some(p=>p.url.endsWith('/input')||p.url.endsWith('/navigate')));});
 await test('recovery Home denial keeps an honest physical Home fallback',{bridge:true,bridgeReply:'{"returnValue":false}',continual:true},async h=>{await h.advance(100);h.video.emit('error');h.nodes.retry.click();await h.advance(600);assert.equal(h.bridgeView.closed,0);assert.equal(h.bridgeCalls.length,1);assert(h.nodes['state-description'].textContent.includes('Press Home'));});

 await test('continuous receiver keeps IME ownership across buffered lead',{text:true,continual:true},async h=>{await h.advance(100);h.document.emit('keyboardStateChange',{detail:{visibility:true}});h.video.buffered={length:1,start:()=>0,end:()=>6};await h.advance(1000);assert.equal(h.view().seekWrites,0);h.document.emit('keydown',{key:'ArrowLeft',target:h.address,preventDefault(){assert.fail('IME intercepted');}});h.document.emit('keyboardStateChange',{detail:{visibility:false}});await h.advance(1250);assert.equal(h.view().seekWrites,0);});
 await test('continuous receiver retains Back and Close with buffered lead',{text:true,continual:true,bridge:true},async h=>{await h.advance(100);h.video.buffered={length:1,start:()=>0,end:()=>6};h.presentation.fullscreen=true;h.presentation.revision=1;await h.advance(1100);h.document.emit('keydown',{key:'Back',preventDefault(){}});assert(!h.classes.has('remote-fullscreen'));await h.advance(1300);h.endButton.click();await h.advance(1500);assert.equal(h.bridgeCalls.length,1);assert.equal(h.posts.filter(p=>p.url.endsWith('/end')).length,1);assert.equal(h.view().seekWrites,0);});
 // Voice receipt card. Synthetic receipts only; never a real utterance.
 const card=(o={})=>Object.assign({v:1,seq:5,phase:'result',ageMs:0,tone:'sent',word:'SENT',headline:'Searching YouTube...',detail:'',badge:'sent',meter:null,meterMs:null,dwellMs:4000,mood:'verified',echo:'lo-fi music'},o);
 const live=(o={})=>card(Object.assign({phase:'released',tone:'work',word:'THINKING',headline:'Got it.',detail:'Working on it...',badge:null,meter:'sweep',dwellMs:null,mood:'thinking',echo:null},o));
 const idleCard=o=>card(Object.assign({phase:'idle',tone:'ready',word:'',headline:'',detail:'',badge:null,meter:null,dwellMs:null,mood:'idle',echo:null},o));
 const shown=h=>!h.nodes['voice-card'].hidden;
 await test('voice receipt renders closed copy and quoted echo without focus, input or layout change',{metricsReply:{ok:true,voice:card()}},async h=>{
  const style=JSON.stringify(h.video.style),focus=h.document.activeElement;await h.advance(100);const n=h.nodes;
  assert(shown(h));assert.equal(n['voice-card-title'].textContent,'Searching YouTube...');assert.equal(n['voice-card-detail'].textContent,'“lo-fi music”');assert.equal(n['voice-card-detail'].hidden,false);
  assert.equal(n['voice-card'].dataset.lines,'2');assert.equal(n['voice-card'].dataset.tone,'sent');assert.equal(n['voice-card'].dataset.exit,'');
  assert.equal(n['voice-card-badge'].hidden,false);assert.equal(n['voice-card-badge'].dataset.badge,'sent');assert.equal(n['voice-card-word'].textContent,'Sent');
  assert.equal(h.document.activeElement,focus);assert.equal(JSON.stringify(h.video.style),style);assert(h.classes.has('page-mode'));
  h.video.emit('click',{clientX:50,clientY:50});await h.advance(300);assert(h.posts.some(p=>p.url.endsWith('/input')&&p.value.click===true));
  assert(!JSON.stringify(h.posts).includes('lo-fi'));
 });
 await test('cannot-do receipt is one line with its badge word and never shows a detail',{metricsReply:{ok:true,voice:card({tone:'nothing',word:'NOTHING DONE',headline:'I’m sorry, I cannot do that.',badge:'nothing',echo:null,dwellMs:5000})}},async h=>{
  await h.advance(100);assert(shown(h));assert.equal(h.nodes['voice-card'].dataset.lines,'1');assert.equal(h.nodes['voice-card-detail'].hidden,true);assert.equal(h.nodes['voice-card-detail'].textContent,'');
  assert.equal(h.nodes['voice-card-title'].textContent,'I’m sorry, I cannot do that.');assert.equal(h.nodes['voice-card-word'].textContent,'Nothing done');
 });
 for(const [badge,word] of [['confirmed','Confirmed'],['sent','Sent'],['unconfirmed','Not confirmed'],['nothing','Nothing done'],['changed','Nothing changed'],['failed','Didn’t work'],['waiting','Waiting for you']])
  await test('badge '+badge+' uses its fixed word',{metricsReply:{ok:true,voice:card({badge,echo:null})}},async h=>{await h.advance(100);assert.equal(h.nodes['voice-card-word'].textContent,word);assert.equal(h.nodes['voice-card-badge'].dataset.badge,badge);});
 await test('receipt dwell hides it, empties nodes and replays the deferred notice once',{metricsReply:{ok:true,voice:card({ageMs:1000})}},async h=>{
  await h.advance(100);assert(shown(h));h.video.emit('playing');h.video.emit('waiting');await h.advance(1300);
  assert.equal(h.status.hidden,true);assert.equal(h.status.textContent,'');assert(shown(h));
  await h.advance(2950);assert(shown(h));assert.equal(h.nodes['voice-card'].dataset.exit,'');
  await h.advance(3100);assert.equal(h.nodes['voice-card'].dataset.exit,'1');assert(shown(h),'exit animates before hiding');
  await h.advance(3300);assert(!shown(h));assert.equal(h.nodes['voice-card-title'].textContent,'');assert.equal(h.nodes['voice-card-detail'].textContent,'');assert.equal(h.nodes['voice-card-word'].textContent,'');
  assert.equal(h.status.textContent,'Loading page...');assert.equal(h.status.hidden,false);
  await h.advance(8000);assert(!shown(h),'a repeated seq never brings a finished receipt back');
 });
 await test('a visible notice moves behind the receipt and playing drops it',{metricsReply:(b,n)=>n<3?{ok:true,voice:null}:{ok:true,voice:card()}},async h=>{
  await h.advance(100);h.video.emit('playing');h.video.emit('waiting');await h.advance(1300);assert.equal(h.status.textContent,'Loading page...');assert.equal(h.status.hidden,false);
  await h.advance(2100);assert(shown(h));assert.equal(h.status.hidden,true);assert.equal(h.status.textContent,'');
  h.video.emit('playing');await h.advance(6500);assert(!shown(h));assert.equal(h.status.hidden,true);assert.equal(h.status.textContent,'');
 });
 await test('older heartbeat replies and older seqs never overwrite a newer receipt',{metricsDelay:n=>n===2?1200:0,metricsReply:(b,n)=>n===1?{ok:true,voice:live()}:n===2?{ok:true,voice:null}:n===3?{ok:true,voice:live({seq:6,phase:'doing',word:'ON IT',headline:'Opening Netflix...',detail:''})}:{ok:true,voice:live({seq:4,headline:'Stale'})}},async h=>{
  await h.advance(100);assert.equal(h.nodes['voice-card-title'].textContent,'Got it.');
  await h.advance(2050);assert.equal(h.nodes['voice-card-title'].textContent,'Opening Netflix...');assert.equal(h.nodes['voice-card'].dataset.lines,'1');
  await h.advance(2300);assert(shown(h));assert.equal(h.nodes['voice-card-title'].textContent,'Opening Netflix...');
  await h.advance(3100);assert.equal(h.nodes['voice-card-title'].textContent,'Opening Netflix...');
 });
 await test('live phases end on null, same-seq idle or a silent mirror',{reducedMotion:true,metricsReply:(b,n)=>n===1||n===3?{ok:true,voice:live()}:n===2?{ok:true,voice:null}:n===4?{ok:true,voice:idleCard()}:{ok:true}},async h=>{
  await h.advance(100);assert(shown(h));assert.equal(h.nodes['voice-card-detail'].textContent,'Working on it...');assert.equal(h.nodes['voice-card-badge'].hidden,true);
  await h.advance(1100);assert(!shown(h));await h.advance(2100);assert(shown(h));await h.advance(3100);assert(!shown(h));await h.advance(6000);assert(!shown(h));
 });
 await test('a live card without fresh replies ends at the local ceiling',{reducedMotion:true,metricsReply:(b,n)=>n===1?{ok:true,voice:live()}:{ok:true}},async h=>{await h.advance(4400);assert(shown(h));await h.advance(4600);assert(!shown(h));});
 await test('a shown receipt keeps its dwell after the mirror goes quiet',{reducedMotion:true,metricsReply:(b,n)=>n===1?{ok:true,voice:card()}:{ok:true,voice:null}},async h=>{await h.advance(3900);assert(shown(h));await h.advance(4100);assert(!shown(h));});
 for(const ageMs of [4000,3600])await test('receipt older than its dwell is never flashed '+ageMs,{metricsReply:{ok:true,voice:card({ageMs})}},async h=>{await h.advance(100);assert(!shown(h));await h.advance(2500);assert(!shown(h));});
 await test('missing voice is nothing new and close alone still returns Home',{bridge:true,metricsReply:(b,n)=>n<3?{ok:true}:{ok:true,close:true}},async h=>{await h.advance(1100);assert(!shown(h));assert.equal(h.posts.filter(p=>p.url.endsWith('/end')).length,0);await h.advance(2500);assert.equal(h.posts.filter(p=>p.url.endsWith('/end')).length,1);});
 await test('close keeps precedence over a receipt and launches Home once',{bridge:true,metricsReply:{ok:true,voice:card(),close:true}},async h=>{await h.advance(500);assert(!shown(h));assert.equal(h.nodes['voice-card-title'].textContent,'');assert.equal(h.posts.filter(p=>p.url.endsWith('/end')).length,1);assert.equal(h.bridgeCalls.length,1);assert(h.metric().final);});
 for(const [label,exit] of [['hidden page',h=>{h.document.hidden=true;h.document.emit('visibilitychange');}],['pagehide',h=>h.window.emit('pagehide')],['Close',h=>h.endButton.click()]])
  await test('receipt is cleared by '+label,{bridge:true,metricsReply:{ok:true,voice:card()}},async h=>{await h.advance(100);assert(shown(h));exit(h);assert(!shown(h));assert.equal(h.nodes['voice-card-detail'].textContent,'');await h.advance(3000);assert(!shown(h));});
 await test('the website editor is never covered by a receipt',{text:true,metricsReply:{ok:true,voice:card({dwellMs:8000})}},async h=>{await h.advance(100);assert(shown(h));h.video.emit('click',{clientX:960,clientY:540});await h.advance(800);assert.equal(h.nodes['editor-form'].hidden,false);assert(!shown(h));await h.advance(2500);assert(!shown(h));});
 const rlo=String.fromCharCode(0x202e),{echo:_,...noEcho}=card();
 const refusedReplies=[['envelope extra',{ok:true,voice:card(),extra:1}],['close with extra',{ok:true,close:true,extra:1}],['ok false',{ok:false,voice:card()}],['close false',{ok:true,close:false,voice:card()}],['card extra key',{ok:true,voice:{...card(),chip:'ready'}}],['card missing key',{ok:true,voice:noEcho}],
  ['schema',{ok:true,voice:card({v:2})}],['seq',{ok:true,voice:card({seq:-1})}],['age',{ok:true,voice:card({ageMs:600001})}],['phase',{ok:true,voice:card({phase:'speaking'})}],['tone',{ok:true,voice:card({tone:'red'})}],['badge',{ok:true,voice:card({badge:'done'})}],['dwell',{ok:true,voice:card({dwellMs:20001})}],
  ['headline length',{ok:true,voice:card({headline:'x'.repeat(41)})}],['detail charset',{ok:true,voice:card({detail:'café'})}],['newline',{ok:true,voice:card({headline:'a\nb'})}],['word charset',{ok:true,voice:card({word:'Sent'})}],['echo control',{ok:true,voice:card({echo:'a'+rlo+'b'})}],['echo length',{ok:true,voice:card({echo:'x'.repeat(49)})}],
  ['echo while listening',{ok:true,voice:live({phase:'listening',echo:'lo-fi'})}],['idle with copy',{ok:true,voice:idleCard({headline:'Listening...'})}],['array',[card()]],['oversize',JSON.stringify({ok:true,voice:card()})+' '.repeat(1100)],['not utf8',Buffer.from([0x7b,0x22,0x6f,0x6b,0x22,0x3a,0xff,0x7d])],['not json','{ok:true']];
 for(const [label,reply] of refusedReplies)await test('heartbeat reply refuses '+label,{bridge:true,metricsReply:reply},async h=>{await h.advance(1100);assert(!shown(h));assert.equal(h.nodes['voice-card-title'].textContent,'');assert.equal(h.posts.filter(p=>p.url.endsWith('/end')).length,0);assert.equal(h.bridgeCalls.length,0);});
 for(const [label,opts] of [['foreign url',{metricsUrl:'http://foreign/metrics'}],['status 202',{metricsStatus:202}],['status 429',{metricsStatus:429}]])
  await test('heartbeat reply refuses '+label,{metricsReply:{ok:true,voice:card(),close:true},...opts},async h=>{await h.advance(1100);assert(!shown(h));assert.equal(h.posts.filter(p=>p.url.endsWith('/end')).length,0);});
 await test('astral echo is bounded by code points and rendered verbatim',{metricsReply:{ok:true,voice:card({echo:'🐈'.repeat(48)})}},async h=>{await h.advance(100);assert.equal(h.nodes['voice-card-detail'].textContent,'“'+'🐈'.repeat(48)+'”');});
 // Exact /metrics reply bytes from one synthetic utterance through the real VoiceStatus,
 // Manager/Trial channel and mirror (voice/backend/test_voice_e2e.py): accepted and rendered verbatim.
 for(const [i,row] of JSON.parse(fs.readFileSync(__dirname+'/voice_card_golden.json','utf8')).replies.entries())
  await test('Spark golden heartbeat reply '+i+' renders as Spark wrote it',{metricsReply:row.reply},async h=>{await h.advance(100);const n=h.nodes;
   assert.equal(shown(h),row.shown);assert.equal(n['voice-card-title'].textContent,row.title);assert.equal(n['voice-card-detail'].textContent,row.detail);assert.equal(n['voice-card-word'].textContent,row.word);});
 assert(!/localStorage|sessionStorage|console\./.test(code));
 // DOM history is used only for the same-URL viewer Back guard, not site history.
 assert.equal((code.match(/navHistory\.replaceState\(/g)||[]).length,1);
 assert.equal((code.match(/navHistory\.pushState\(/g)||[]).length,2);
 assert(!/navHistory\.(?:back|forward|go)\(/.test(code));
 console.log(JSON.stringify({groups}));
}
main().catch(e=>{console.error(e);process.exitCode=1;});
