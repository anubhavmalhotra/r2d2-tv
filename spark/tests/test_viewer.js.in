 await test('action backlog remains bounded and rejects are counted',{slowInput:true},async h=>{await h.advance(100);for(let n=0;n<30;n++)h.document.emit('keydown',{key:'Enter',preventDefault(){}});await h.advance(2000);const m=h.posts.filter(r=>r.url.endsWith('/metrics')).at(-1).value;assert.equal(m.inputActionsSent,9);assert.equal(m.inputRejected,21);});
 await test('pointer sends near60Hz instead of8Hz and retains only latest pending point',{},async h=>{
  await h.advance(100);
  for(let ms=100;ms<1100;ms+=5){await h.advance(ms);h.video.emit('mousemove',{clientX:ms,clientY:540});}
  await h.advance(1120);
  const moves=h.posts.filter(r=>r.url.endsWith('/input'));
  assert(moves.length>=58&&moves.length<=61,'pointer must use frame pacing, not125ms slots');
  for(let n=1;n<moves.length;n++)assert(moves[n].at-moves[n-1].at>=1000/60-1e-8,'pointer exceeds60Hz');
  assert.equal(moves.at(-1).value.x,1095/1920);
  assert(moves.at(-1).at-1095<=1000/60+1e-8,'latest pointer waited an extra slot');
 });
 await test('pending wheel slot cannot hold an eligible pointer and click stays immediate',{},async h=>{
  await h.advance(100);
  const wheel=()=>h.nodes.page.emit('wheel',{target:h.video,clientX:960,clientY:540,deltaY:3,deltaMode:0,preventDefault(){}});
  wheel();await h.advance(101);wheel();h.video.emit('mousemove',{clientX:800,clientY:540});
  await h.advance(102);h.video.emit('mousemove',{clientX:900,clientY:540});h.video.emit('click',{clientX:1000,clientY:540});
  await h.advance(150);
  const sent=h.posts.filter(r=>r.url.endsWith('/input'));
  assert.deepEqual(sent.map(r=>r.value.kind),['wheel','point','point']);
  assert.equal(sent[1].at,101);assert.equal(sent[1].value.x,800/1920);
  assert.equal(sent[2].at,102);assert.equal(sent[2].value.click,true);
 });
 await test('wheel coalesces at30Hz without an unbounded scroll backlog',{},async h=>{
  await h.advance(100);
  for(let ms=100;ms<1100;ms+=5){await h.advance(ms);h.nodes.page.emit('wheel',{target:h.video,clientX:960,clientY:540,deltaY:3,deltaMode:0,preventDefault(){}});}
  await h.advance(1140);
  const wheels=h.posts.filter(r=>r.url.endsWith('/input'));
  assert(wheels.length>=30&&wheels.length<=31,'scroll must exceed old10Hz cap');
  assert.equal(wheels.reduce((sum,r)=>sum+r.value.deltaY,0),600);
  assert(wheels.some(r=>r.value.deltaY>3),'scroll samples must coalesce');
  for(let n=1;n<wheels.length;n++)assert(wheels[n].at-wheels[n-1].at>=1000/30-1e-8,'wheel exceeds30Hz');
 });

