 await test('unknown mutation never replays and keeps further edits local',{text:true,tabs:true,noTextCommit:true,continual:true},async h=>{await h.advance(100);h.video.emit('click',{clientX:960,clientY:540});await h.advance(300);const f=h.nodes['editor-input'];f.value='sent';f.emit('input');await h.advance(1000);f.value='not replayed';f.emit('input');await h.advance(13000);assert.equal(h.posts.filter(p=>p.url.endsWith('/editor')).length,1);assert.equal(f.value,'not replayed');assert.equal(h.nodes.go.disabled,true);h.endButton.click();assert.equal(f.value,'');});
