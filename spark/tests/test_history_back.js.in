'use strict';
const fs=require('fs'),assert=require('assert');
const {fixture}=require('./viewer_fixture');
const root=__dirname,code=fs.readFileSync(process.env.VIEWER_SOURCE||root+'/viewer.js','utf8'),guardStart=code.indexOf('  // TinyBrowser defaults to platform History Back'),guardEnd=code.indexOf('  run();\n}());',guardStart),old=code.slice(0,guardStart)+code.slice(guardEnd);
assert(guardStart>=0&&guardEnd>guardStart);let groups=0;
const opts={ring:true,audio:true,layout:true,fixedViewport:true,text:true,tabs:true,continual:true,currentTime:0,bufferEnd:1,bridge:true,source:code};
async function test(name,extra,run){const h=await fixture({...opts,...extra});await run(h);groups++;console.log('PASS '+name);}
async function main(){
 await test('previous key-only viewer loses default platform Back at entry',{source:old},async h=>{await h.advance(100);h.presentation.fullscreen=true;h.presentation.revision=1;await h.advance(1100);assert(h.classes.has('remote-fullscreen'));h.platformBack();assert.equal(h.historyView().exitDialogs,1);assert(h.classes.has('remote-fullscreen'));assert(h.classes.has('page-mode'));assert(!h.posts.some(p=>p.url.endsWith('/presentation')||p.url.endsWith('/history')));});
 await test('default History Back exposes controls synchronously and asks remote fullscreen exit once',{presentationPostStall:true},async h=>{await h.advance(100);h.presentation.fullscreen=true;h.presentation.revision=1;await h.advance(1100);assert(h.classes.has('remote-fullscreen'));h.platformBack();assert(!h.classes.has('remote-fullscreen'));assert(!h.classes.has('page-mode'));assert.equal(h.document.activeElement,h.address);await h.advance(14000);assert(h.presentation.fullscreen);assert.equal(h.posts.filter(p=>p.url.endsWith('/presentation')).length,1);assert.equal(h.historyView().exitDialogs,0);h.nodes.reload.click();await h.advance(14500);assert.equal(h.posts.filter(p=>p.url.endsWith('/history')&&p.value.action==='reload').length,1);h.endButton.click();await h.advance(15000);assert.equal(h.bridgeCalls.length,1);});
 await test('page controls remain recoverable after90s even though source page has no outer media failure',{},async h=>{await h.advance(90100);h.platformBack();assert(!h.classes.has('page-mode'));assert(!h.classes.has('remote-fullscreen'));assert.equal(h.document.activeElement,h.address);assert.equal(h.nodes.reload.disabled,false);assert.equal(h.endButton.disabled,false);assert.equal(h.historyView().exitDialogs,0);assert(!h.posts.some(p=>p.value.final));});
 await test('500 history Back gestures keep one guard and exact unchanged receiverURL',{},async h=>{await h.advance(100);for(let i=0;i<500;i++)h.platformBack();assert.deepEqual(h.historyView(),{length:2,index:1,exitDialogs:0});assert(h.historyEntries.every(e=>e.url==='http://{{SPARK_IP}}:4177/'+'a'.repeat(48)+'/viewer'));assert(h.historyOperations.every(op=>JSON.stringify(op[1])==='{"r2d2ViewerBack":"base"}'||JSON.stringify(op[1])==='{"r2d2ViewerBack":"guard"}'));assert(!h.posts.some(p=>p.url.endsWith('/history')||p.url.endsWith('/input')||p.url.endsWith('/end')));});
 await test('manual461 path still reveals controls and immediate duplicate pop is not handled twice',{},async h=>{await h.advance(100);h.presentation.fullscreen=true;h.presentation.revision=1;await h.advance(1100);h.document.emit('keydown',{keyCode:461,preventDefault(){}});const focused=h.document.activeElement;h.platformBack();assert.equal(h.document.activeElement,focused);await h.advance(1500);assert.equal(h.posts.filter(p=>p.url.endsWith('/presentation')).length,1);assert.equal(h.historyView().length,2);});
 await test('manual editor Back and immediate History duplicate perform only one logical level',{},async h=>{await h.advance(100);h.video.emit('click',{clientX:960,clientY:540});await h.advance(300);assert.equal(h.nodes['editor-form'].hidden,false);h.document.emit('keydown',{keyCode:461,target:h.nodes['editor-input'],preventDefault(){}});assert.equal(h.nodes['editor-form'].hidden,true);assert(h.classes.has('page-mode'));h.platformBack();assert(h.classes.has('page-mode'));h.document.emit('keyup',{keyCode:461});h.platformBack();assert(!h.classes.has('page-mode'));});
 await test('stale or foreign popstate cannot change focus or add entries',{},async h=>{await h.advance(100);const before=h.historyOperations.length;for(const state of [null,{r2d2ViewerBack:'foreign'},{r2d2ViewerBack:'base',extra:true},{r2d2ViewerBack:'base'}])h.window.emit('popstate',{state});assert.equal(h.historyOperations.length,before);assert(h.classes.has('page-mode'));assert(!h.posts.some(p=>p.url.endsWith('/presentation')));});
 await test('foreign event state at an own base entry is not admitted',{},async h=>{await h.advance(100);h.historyModel.replaceState({r2d2ViewerBack:'base'},'');const before=h.historyOperations.length;h.window.emit('popstate',{state:{r2d2ViewerBack:'foreign'}});assert.equal(h.historyOperations.length,before);assert(h.classes.has('page-mode'));});
 await test('closed startup failure History Back returns Home without Close action',{unsupported:true},async h=>{await h.advance(1000);assert.equal(h.nodes['state-title'].textContent,'Your browser connection stopped');assert.equal(h.bridgeCalls.length,0);h.platformBack();h.platformBack();await h.advance(1600);assert.equal(h.bridgeCalls.length,1);assert.equal(h.bridgeView.closed,1);});
 await test('native IME owns Back and its address draft while keyboard is visible',{},async h=>{await h.advance(100);h.platformBack();h.address.click();h.address.value='example.com';h.document.emit('keyboardStateChange',{detail:{visibility:true}});h.platformBack();assert.equal(h.address.value,'example.com');assert.equal(h.address.readOnly,false);assert(!h.posts.some(p=>p.url.endsWith('/navigate')||p.url.endsWith('/input')));h.document.emit('keyboardStateChange',{detail:{visibility:false}});h.platformBack();assert.equal(h.address.value,'example.com');assert.equal(h.address.readOnly,true);assert.equal(h.document.activeElement,h.nodes.go);});
 await test('composition Back does not discard or submit partial draft',{},async h=>{await h.advance(100);h.platformBack();h.address.click();h.address.emit('compositionstart');h.address.value='part';h.platformBack();assert.equal(h.address.value,'part');assert.equal(h.address.readOnly,false);assert(!h.posts.some(p=>p.url.endsWith('/navigate')||p.url.endsWith('/editor')));h.address.emit('compositionend');h.platformBack();assert.equal(h.address.value,'part');assert.equal(h.address.readOnly,true);});
 await test('direct site editor Back retains commit and close order',{},async h=>{await h.advance(100);h.video.emit('click',{clientX:960,clientY:540});await h.advance(300);assert.equal(h.nodes['editor-form'].hidden,false);const field=h.nodes['editor-input'];field.value='latest draft';field.emit('input');h.platformBack();await h.advance(1400);assert.equal(h.posts.filter(p=>p.url.endsWith('/editor')).length,1);assert.equal(h.posts.find(p=>p.url.endsWith('/editor')).value.value,'latest draft');assert.equal(h.nodes['editor-form'].hidden,true);h.platformBack();assert(!h.classes.has('page-mode'));assert.equal(h.historyView().exitDialogs,0);});
 await test('closed receiver History Back uses existing idempotent Home return',{},async h=>{await h.advance(100);h.endButton.click();h.platformBack();h.platformBack();await h.advance(700);assert.equal(h.bridgeCalls.length,1);assert.equal(h.posts.filter(p=>p.url.endsWith('/end')).length,1);assert.equal(h.bridgeView.closed,1);assert.equal(h.historyView().exitDialogs,0);});
 await test('transport pause retains controls with default platform Back',{},async h=>{await h.advance(100);h.streams[0].fail();await h.advance(200);assert.equal(h.nodes['state-title'].textContent,'Video connection paused');h.platformBack();assert(!h.classes.has('page-mode'));assert(!h.classes.has('remote-fullscreen'));assert.equal(h.endButton.disabled,false);h.endButton.click();await h.advance(800);assert.equal(h.bridgeCalls.length,1);});
 await test('Home stays platform-owned with no website input or DOM history write',{},async h=>{await h.advance(100);const before=h.historyOperations.length;h.document.emit('keydown',{keyCode:36,key:'Home',preventDefault(){assert.fail('Home intercepted');}});assert.equal(h.historyOperations.length,before);assert(!h.posts.some(p=>p.url.endsWith('/input')));});
 await test('missing DOM history preserves manual461 compatibility',{noDOMHistory:true},async h=>{await h.advance(100);h.document.emit('keydown',{keyCode:461,preventDefault(){}});assert(!h.classes.has('page-mode'));assert.equal(h.document.activeElement,h.address);});
 await test('history setup exception does not make a successful-guard claim',{historyThrows:true},async h=>{await h.advance(100);assert(h.status.textContent.includes('Back controls could not be prepared'));assert.equal(h.historyOperations.length,0);h.document.emit('keydown',{keyCode:461,preventDefault(){}});assert(!h.classes.has('page-mode'));});
 await test('platform History Back cancels owned voice once without leaving receiver',{toolbar:true,voiceReply:(action,body)=>action==='get'?{schema:1,available:true,state:'idle',request:null}:{schema:1,available:true,state:action==='start'?'listening':'refused',request:body.request}},async h=>{await h.advance(100);h.nodes.mic.click();await h.advance(200);assert(h.nodes['voice-label'].textContent.startsWith('Listening'));h.platformBack();await h.advance(400);assert(h.nodes['voice-status'].hidden);assert.equal(h.document.activeElement,h.nodes.mic);assert.deepEqual(h.posts.filter(p=>p.url.endsWith('/voice')).map(p=>p.value.action),['start','cancel']);assert.equal(h.historyView().exitDialogs,0);});
 console.log(JSON.stringify({groups,nativeCalls:0,TVContacted:false,physicalBackQualified:false}));
}
main().catch(e=>{console.error(e);process.exitCode=1;});
