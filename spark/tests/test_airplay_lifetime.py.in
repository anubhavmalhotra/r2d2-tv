"""AirPlay owner RPC and long-lived viewer regressions; local children only."""
import os
import fcntl
from pathlib import Path
import tempfile
from unittest.mock import patch
import subprocess
import sys
import threading
import time
import unittest

import airplay as ap


class _GracefulLocalOwner:
    """Exercise the real RPC loop with an owned child using a normal TERM grace."""
    def __init__(self, cleanup_delay=0):
        self.root = os.getpid()
        self.handles, self.processes = {}, []
        self.stderr_bytes = 0
        self.cleanup_delay = cleanup_delay

    def discover(self):
        pass

    def spawn(self, argv, **kwargs):
        p = subprocess.Popen(argv, **kwargs)
        self.processes.append(p)
        return p

    def terminate(self, p):
        if p.poll() is None:
            p.terminate()
        try:
            # This fixture tests the proxy's teardown RPC budget, not the
            # production owner's TERM deadline. Its child takes 0.3s to exit;
            # 0.4s left only 0.1s of scheduler headroom on a busy CI runner.
            # Keep the delay above the old 0.12s RPC cap while allowing it a
            # full second here, still inside the proxy's normal 2s deadline.
            p.wait(timeout=1.0)
        except subprocess.TimeoutExpired:
            p.kill()
            p.wait(timeout=1)

    def cleanup(self):
        time.sleep(self.cleanup_delay)
        for p in self.processes:
            if p.poll() is None:
                p.kill()
            p.wait(timeout=1)
            for stream in (p.stdin, p.stdout, p.stderr):
                if stream is not None:
                    stream.close()
        return {'verified': True, 'remaining_owned_count': 0}


class AirPlayOwnerLifetimeTests(unittest.TestCase):
    def setUp(self):
        self.owners = []

    def tearDown(self):
        for proxy, raw in self.owners:
            proxy.cleanup()
            raw.cleanup()
            proxy._worker_thread.join(1)
            self.assertFalse(proxy._worker_thread.is_alive())
            self.assertTrue(all(p.poll() is not None for p in raw.processes))

    def owner(self, cleanup_delay=0):
        raw = _GracefulLocalOwner(cleanup_delay)
        proxy = ap.IsolatedProcessOwner(owner_factory=lambda: raw)
        self.owners.append((proxy, raw))
        return proxy

    def child(self, proxy):
        # Signal setup is acknowledged before termination; no arbitrary startup sleep.
        code = (
            'import os,signal,time\n'
            'def done(*args):\n'
            ' time.sleep(0.3)\n'
            ' raise SystemExit(0)\n'
            'signal.signal(signal.SIGTERM,done)\n'
            'os.write(1,b"R")\n'
            'time.sleep(60)\n'
        )
        p = proxy.spawn([sys.executable, '-B', '-c', code],
                        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE)
        self.assertEqual(p.stdout.read(1), b'R')
        return p

    def test_normal_terminate_allows_existing_child_term_grace(self):
        proxy = self.owner()
        p = self.child(proxy)
        self.assertTrue(proxy.terminate(p))
        self.assertEqual(p.wait(timeout=1), 0)
        self.assertTrue(proxy.cleanup()['verified'])

    def test_normal_session_close_keeps_cleanup_budget(self):
        proxy = self.owner(cleanup_delay=0.25)
        session = ap.AirPlayRelaySession('a' * 32, pin=1234)
        session.bind_process_owner(proxy)
        session.close('sender-disconnected')
        self.assertTrue(proxy.cleanup()['verified'])
        self.assertFalse(proxy._stop_requested)

    def test_normal_session_close_reaps_graceful_child(self):
        proxy = self.owner()
        session = ap.AirPlayRelaySession('b' * 32, pin=1234)
        session.bind_process_owner(proxy)
        session._uxplay_proc = self.child(proxy)
        session._terminate_fn = proxy.terminate
        session.close('viewer-hidden')
        self.assertTrue(proxy.cleanup()['verified'])

    def test_explicit_stop_reaps_acknowledged_graceful_child(self):
        proxy = self.owner()
        session = ap.AirPlayRelaySession('9' * 32, pin=1234)
        session.bind_process_owner(proxy)
        child = self.child(proxy)
        session._uxplay_proc = child
        session._terminate_fn = proxy.terminate
        session.request_stop()
        session.close('owner-ended')
        self.assertEqual(child.poll(), 0)
        self.assertFalse(proxy._broken)
        self.assertTrue(proxy.cleanup()['verified'])

    def test_explicit_stop_preserves_finite_cleanup_budget(self):
        proxy = self.owner(cleanup_delay=0.3)
        session = ap.AirPlayRelaySession('c' * 32, pin=1234)
        session.bind_process_owner(proxy)
        session.request_stop()
        started = time.monotonic()
        self.assertTrue(proxy.cleanup()['verified'])
        self.assertLess(time.monotonic() - started, 1.0)
        self.assertTrue(proxy._stop_requested)

    def test_service_duplicate_stop_does_not_interrupt_pending_rpc(self):
        proxy = self.owner()
        raw = self.owners[-1][1]
        entered, release = threading.Event(), threading.Event()
        errors = []
        def discover():
            entered.set()
            release.wait(1)
        def rpc():
            try:
                proxy.discover()
            except Exception as exc:
                errors.append(type(exc).__name__)
        session = ap.AirPlayRelaySession('f' * 32, pin=1234)
        session.bind_process_owner(proxy)
        service = ap.AirPlayService.__new__(ap.AirPlayService)
        service.closed = False
        service.active_session, service.active_owner = session, proxy
        with patch.object(raw, 'discover', discover):
            worker = threading.Thread(target=rpc)
            worker.start()
            try:
                self.assertTrue(entered.wait(1))
                service.request_stop()
                self.assertFalse(proxy._interrupted)
            finally:
                release.set()
                worker.join(1)
        self.assertFalse(worker.is_alive())
        self.assertEqual(errors, [])
        self.assertTrue(proxy.cleanup()['verified'])

    def test_blocked_operational_discover_retains_short_stop_budget(self):
        proxy = self.owner()
        raw = self.owners[-1][1]
        entered, release = threading.Event(), threading.Event()
        errors = []
        def discover():
            entered.set()
            release.wait(1)
        def rpc():
            try:
                proxy.discover()
            except Exception as exc:
                errors.append(type(exc).__name__)
        with patch.object(raw, 'discover', discover):
            worker = threading.Thread(target=rpc)
            worker.start()
            try:
                self.assertTrue(entered.wait(1))
                proxy.request_stop()
                worker.join(0.4)
                self.assertFalse(worker.is_alive())
                self.assertTrue(errors)
                self.assertEqual(proxy._broken_error, 'SUBREAPER_RPC_TIMEOUT')
                self.assertFalse(proxy.cleanup()['verified'])
            finally:
                release.set()
                worker.join(1)

    def test_repeated_stop_and_cap_cannot_shorten_active_cleanup(self):
        proxy = self.owner(cleanup_delay=0.25)
        raw = self.owners[-1][1]
        entered = threading.Event()
        original = raw.cleanup
        def cleanup():
            entered.set()
            return original()
        results = []
        with patch.object(raw, 'cleanup', cleanup):
            worker = threading.Thread(target=lambda: results.append(proxy.cleanup()))
            worker.start()
            try:
                self.assertTrue(entered.wait(1))
                proxy.request_stop()
                proxy.request_stop()
                proxy.cap_deadline(0.02)
                self.assertFalse(proxy._interrupted)
            finally:
                worker.join(1)
        self.assertFalse(worker.is_alive())
        self.assertEqual(len(results), 1)
        self.assertTrue(results[0]['verified'])

    def test_cleanup_deadline_still_refuses_slow_peer(self):
        proxy = self.owner(cleanup_delay=0.25)
        proxy.cleanup_timeout_s = 0.08
        proxy.request_stop()
        started = time.monotonic()
        self.assertFalse(proxy.cleanup()['verified'])
        self.assertLess(time.monotonic() - started, 0.3)
        self.assertEqual(proxy._broken_error, 'SUBREAPER_RPC_TIMEOUT')

    def test_cleanup_lock_wait_and_reply_share_one_deadline(self):
        proxy = self.owner(cleanup_delay=0.1)
        proxy.cleanup_timeout_s = 0.15
        entered = threading.Event()
        original = proxy._effective_rpc_deadline
        def deadline(*args, **kwargs):
            result = original(*args, **kwargs)
            if kwargs.get('teardown'):
                entered.set()
            return result
        results = []
        proxy._rpc_lock.acquire()
        with patch.object(proxy, '_effective_rpc_deadline', deadline):
            worker = threading.Thread(target=lambda: results.append(proxy.cleanup()))
            worker.start()
            try:
                self.assertTrue(entered.wait(1))
                time.sleep(0.1)
            finally:
                proxy._rpc_lock.release()
                worker.join(1)
        self.assertFalse(worker.is_alive())
        self.assertEqual(len(results), 1)
        self.assertFalse(results[0]['verified'])
        self.assertEqual(proxy._broken_error, 'SUBREAPER_RPC_TIMEOUT')

    def test_explicit_interrupt_still_refuses_cleanup(self):
        proxy = self.owner()
        proxy.interrupt()
        self.assertFalse(proxy.cleanup()['verified'])
        self.assertEqual(proxy._broken_error, 'SUBREAPER_INTERRUPTED')

    def test_idle_stop_with_updater_gate_releases_only_listener_journal(self):
        proxy = self.owner(cleanup_delay=0.25)
        entered, tv_calls = threading.Event(), []
        def relay(session, *_args, **_kwargs):
            entered.set()
            while not session._stop_requested:
                time.sleep(0.005)
            session.close('owner-ended')
            return session.snapshot()
        with tempfile.TemporaryDirectory() as tmp:
            journal = Path(tmp) / 'session-pending'
            service = ap.AirPlayService(
                {'pin': 1234}, journal=journal, owner_factory=lambda: proxy,
                tv_launch=lambda *a, **k: tv_calls.append(True))
            with patch.object(ap.AirPlayRelaySession, 'run_relay', relay):
                self.assertTrue(service.start(max_sessions=1))
                self.assertTrue(entered.wait(1))
                self.assertTrue(service.listen_journal.exists())
                fd = os.open(journal, os.O_CREAT | os.O_EXCL | os.O_RDWR, 0o600)
                os.write(fd, b'updater-owned')
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                try:
                    service.request_stop()
                    self.assertTrue(service.close(timeout_s=1))
                    self.assertEqual(service.state, 'closed')
                    self.assertTrue(proxy.cleanup_verified)
                    self.assertFalse(service.listen_journal.exists())
                    self.assertEqual(journal.read_bytes(), b'updater-owned')
                    self.assertEqual(tv_calls, [])
                finally:
                    os.close(fd)
                    service.close(timeout_s=1)

    def test_default_viewer_lives_past_half_hour_with_current_heartbeat(self):
        now = [0.0]
        session = ap.AirPlayRelaySession('d' * 32, pin=1234, clock=lambda: now[0])
        host = ap.AirPlayViewerHost(session, clock=lambda: now[0])
        try:
            host.note_tv_open()
            with host.lock:
                now[0] = 3601.0
                host.last_viewer_heartbeat = now[0]
            self.assertTrue(host.capture_allowed())
            self.assertLessEqual(len(host.metrics), 128)
            now[0] += 15.0
            self.assertFalse(host.capture_allowed())
            self.assertTrue(session.closed)
        finally:
            host.close()
            host._watchdog_thread.join(1)
            self.assertFalse(host._watchdog_thread.is_alive())

    def test_explicit_viewer_deadline_is_still_enforced(self):
        now = [0.0]
        session = ap.AirPlayRelaySession('e' * 32, pin=1234, clock=lambda: now[0])
        host = ap.AirPlayViewerHost(session, max_duration_s=2, clock=lambda: now[0])
        try:
            host.note_tv_open()
            now[0] = 2.0
            host.last_viewer_heartbeat = now[0]
            self.assertFalse(host.capture_allowed())
            self.assertTrue(session.closed)
        finally:
            host.close()
            host._watchdog_thread.join(1)
            self.assertFalse(host._watchdog_thread.is_alive())

    def test_viewer_stop_reason_survives_relay_exit_before_stop_finishes(self):
        for trigger, expected in (
            ('deadline-expired', 'owner-ended'),
            ('viewer-heartbeat-lost', 'owner-ended'),
            ('owner-ended', 'owner-ended'),
            ('viewer-ended', 'teardown'),
            ('viewer-hidden', 'viewer-hidden'),
        ):
            with self.subTest(trigger=trigger):
                teardown = []
                session = ap.AirPlayRelaySession(
                    'f' * 32, pin=1234, clock=lambda: 0.0,
                    tv_teardown_callback=lambda **row: teardown.append(row['reason']),
                )
                host = ap.AirPlayViewerHost(session, clock=lambda: 0.0)
                worker = threading.Thread(target=lambda: host.request_stop(trigger))
                try:
                    # Freeze the stop caller after it publishes host.stop but
                    # before it reaches session.close. The relay can now observe
                    # that stop and take its normal sender-disconnected finally.
                    with host.media_stream.cv:
                        worker.start()
                        self.assertTrue(host.stop.wait(1))
                        self.assertFalse(session._check_viewer_deadlines())
                        session.close('sender-disconnected')
                    worker.join(1)
                    self.assertFalse(worker.is_alive())
                    self.assertEqual(session.close_reason, expected)
                    self.assertEqual(teardown, [expected])
                finally:
                    host.close()
                    worker.join(1)
                    host._watchdog_thread.join(1)
                    self.assertFalse(worker.is_alive())
                    self.assertFalse(host._watchdog_thread.is_alive())


if __name__ == '__main__':
    unittest.main()
