"""Unit tests for Spark 4K60 / 4K120 AirPlay profiles, UxPlay ingress, and relay session."""
import unittest
import airplay as ap
import airplay_ingress as ai
import build_viewer as bv
import media_profile as mp
import media_ring as mr
import protocol as proto
from test_media_ring import init_bytes, pair


def init_bytes_level(level_idc):
    return init_bytes(hvcc_change=lambda h: h.__setitem__(12, level_idc))


class MediaProfileTests(unittest.TestCase):
    def test_closed_profiles_and_lookup(self):
        p60 = mp.profile_for_name('4k60_hevc')
        self.assertEqual(p60.codec_string, 'hvc1.1.6.L153.B0')
        self.assertEqual((p60.width, p60.height, p60.fps, p60.level_idc, p60.frame_duration_ticks),
                         (3840, 2160, 60, 153, 1500))
        p120 = mp.profile_for_name('4k120_hevc')
        self.assertEqual(p120.codec_string, 'hvc1.1.6.L156.B0')
        self.assertEqual((p120.width, p120.height, p120.fps, p120.level_idc, p120.frame_duration_ticks),
                         (3840, 2160, 120, 156, 750))
        self.assertEqual(mp.profile_for_codec('hvc1.1.6.L156.B0'), p120)
        with self.assertRaises(ValueError):
            mp.profile_for_name('1080p60')
        with self.assertRaises(ValueError):
            mp.profile_for_codec('hev1.1.6.L153.B0')

    def test_inspect_init_profile_detects_4k60_and_4k120(self):
        ftyp60, moov60 = init_bytes_level(153)
        self.assertEqual(mp.inspect_init_profile(ftyp60, moov60), mp.PROFILE_4K60_HEVC)
        ftyp120, moov120 = init_bytes_level(156)
        self.assertEqual(mp.inspect_init_profile(ftyp120, moov120), mp.PROFILE_4K120_HEVC)
        ftyp_bad, moov_bad = init_bytes_level(120)
        with self.assertRaisesRegex(mr.MediaError, 'HVCC_PROFILE'):
            mp.inspect_init_profile(ftyp_bad, moov_bad)


class AirPlayIngressTests(unittest.TestCase):
    def test_uxplay_version_gate_requires_1_73_7(self):
        self.assertEqual(ai.require_uxplay_version('UxPlay version 1.73.7; for help, use option "-h"'), (1, 73, 7))
        self.assertEqual(ai.require_uxplay_version('UxPlay 1.73.7 (AirPlay2 Mirroring)'), (1, 73, 7))
        self.assertEqual(ai.require_uxplay_version('UxPlay v1.74.0'), (1, 74, 0))
        for old in (
            'UxPlay version 1.73.6; for help, use option "-h"',
            'UxPlay 1.68.2',
            'UxPlay 1.72.3',
            'UxPlay 1.73.6',
        ):
            with self.subTest(old=old), self.assertRaisesRegex(ValueError, 'UXPLAY_VERSION_TOO_OLD'):
                ai.require_uxplay_version(old)

    def test_uxplay_command_4k60_and_4k120_loopback_only_no_hls(self):
        cmd60 = ai.build_uxplay_command(profile_name='4k60_hevc', pin=1234, fps_data=True)
        self.assertIn('-h265', cmd60)
        self.assertIn('3840x2160@60', cmd60)
        self.assertIn('-nh', cmd60)
        self.assertNotIn('-hls', cmd60)
        self.assertIn('1234', cmd60)
        self.assertIn('-FPSdata', cmd60)
        self.assertTrue(any('host=127.0.0.1 port=5000' in x and 'timestamp-offset=0' in x for x in cmd60))
        self.assertTrue(any('host=127.0.0.1 port=5002' in x and 'timestamp-offset=0' in x for x in cmd60))

        synthetic_id = ':'.join(('AA', 'BB', 'CC', 'DD', 'EE', 'FF'))
        cmd120 = ai.build_uxplay_command(
            profile_name='4k120_hevc',
            device_id=synthetic_id,
            password='private-password',
        )
        self.assertIn('3840x2160@120', cmd120)
        self.assertIn('120', cmd120)
        self.assertIn(synthetic_id, cmd120)

        with self.assertRaises(ValueError):
            ai.build_uxplay_command(pin=1234, password='conflict-password')
        with self.assertRaises(ValueError):
            ai.build_uxplay_command(video_rtp_port=5000, audio_rtp_port=5000)
        self.assertIn('0001', ai.build_uxplay_command(pin=1))
        self.assertIn('9999', ai.build_uxplay_command(pin=9999))
        for bad_pin in (0, -1, 10000, True):
            with self.subTest(bad_pin=bad_pin), self.assertRaisesRegex(ValueError, 'UXPLAY_PIN'):
                ai.build_uxplay_command(pin=bad_pin)

    def test_remux_and_reencode_commands_and_sdp(self):
        sdp = ai.build_loopback_sdp(video_rtp_port=5000, audio_rtp_port=5002).decode('ascii')
        self.assertIn('m=video 5000 RTP/AVP 96', sdp)
        self.assertIn('a=rtpmap:96 H265/90000', sdp)
        self.assertIn('m=audio 5002 RTP/AVP 96', sdp)
        self.assertIn('a=rtpmap:96 L16/44100/2', sdp)

        b1 = ai.build_remux_command(short_fragment=True)
        self.assertIn('-listen_timeout', b1)
        self.assertIn('15', b1)
        self.assertIn('sdp', b1)
        self.assertIn('pipe:0', b1)
        self.assertIn('0:v:0', b1)
        self.assertIn('0:a:0', b1)
        self.assertIn('copy', b1)
        self.assertIn('16667', b1)
        with self.assertRaisesRegex(ValueError, 'SDP_LISTEN_TIMEOUT'):
            ai.build_remux_command(listen_timeout_s=0)

        b2_120 = ai.build_reencode_command(profile_name='4k120_hevc', short_fragment=True)
        self.assertIn('-listen_timeout', b2_120)
        self.assertIn('sdp', b2_120)
        self.assertIn('pipe:0', b2_120)
        self.assertIn('0:v:0', b2_120)
        self.assertIn('0:a:0', b2_120)
        self.assertIn('hevc_nvenc', b2_120)
        self.assertIn('5.2', b2_120)
        with self.assertRaisesRegex(ValueError, 'SDP_LISTEN_TIMEOUT'):
            ai.build_reencode_command(listen_timeout_s=301)

    def test_reencode_letterboxes_any_sender_shape_to_fixed_4k(self):
        for name, fps, level, rate, peak in (
            ('4k60_hevc', 60, '5.1', '30M', '40M'),
            ('4k120_hevc', 120, '5.2', '45M', '60M'),
        ):
            with self.subTest(profile=name):
                cmd = ai.build_reencode_command(profile_name=name)
                # hevc_cuvid fails after a mid-stream size change; the hwaccel does not.
                self.assertNotIn('hevc_cuvid', cmd)
                self.assertEqual(cmd[cmd.index('-hwaccel') + 1], 'cuda')
                self.assertLess(cmd.index('-hwaccel'), cmd.index('-i'))
                vf = cmd[cmd.index('-vf') + 1]
                self.assertIn("scale=w='max(2,trunc(min(3840,2160*dar)/2)*2)'", vf)
                self.assertIn("h='max(2,trunc(min(2160,3840/dar)/2)*2)'", vf)
                self.assertIn('pad=w=3840:h=2160:x=(ow-iw)/2:y=(oh-ih)/2', vf)
                self.assertTrue(vf.endswith(f',fps={fps}'))
                self.assertEqual(cmd[cmd.index('-level:v') + 1], level)
                self.assertEqual(cmd[cmd.index('-tier') + 1], 'main')
                self.assertEqual(cmd[cmd.index('-b:v') + 1], rate)
                self.assertEqual(cmd[cmd.index('-maxrate') + 1], peak)
                self.assertEqual(cmd[cmd.index('-g') + 1], str(fps))
                self.assertEqual(cmd[cmd.index('-bf') + 1], '0')
                self.assertEqual(cmd[cmd.index('-pix_fmt') + 1], 'yuv420p')
                self.assertEqual(cmd[cmd.index('-fps_mode:v') + 1], 'cfr')
                self.assertEqual(cmd[cmd.index('-r:v') + 1], str(fps))
                self.assertNotIn('asetpts=N+1024', ' '.join(cmd))

    def test_rtp_input_tolerates_bursts_and_unset_sender_timestamps(self):
        for cmd in (ai.build_remux_command(), ai.build_reencode_command()):
            with self.subTest(cmd=cmd[cmd.index('-c:v') + 1]):
                head = cmd[:cmd.index('-i')]
                self.assertEqual(head[head.index('-buffer_size') + 1], str(ai.RTP_RECEIVE_BUFFER_BYTES))
                self.assertEqual(head[head.index('-use_wallclock_as_timestamps') + 1], '1')

    def test_uxplay_lets_a_second_device_take_over(self):
        self.assertIn('-nohold', ai.build_uxplay_command(pin=1234))

    def test_av_sync_verification_contract(self):
        ok = ai.verify_av_sync(1000.0, 1024.5)
        self.assertTrue(ok['qualified'])
        self.assertEqual(ok['absOffsetMs'], 24.5)
        bad = ai.verify_av_sync(1000.0, 1055.0)
        self.assertFalse(bad['qualified'])


class AirPlayRelayAndProtocolTests(unittest.TestCase):
    def test_relay_session_4k60_and_4k120_handoff_and_teardown(self):
        for level_idc, expected_profile, expected_codec in (
            (153, '4k60_hevc', 'hvc1.1.6.L153.B0'),
            (156, '4k120_hevc', 'hvc1.1.6.L156.B0'),
        ):
            events = []
            session = ap.AirPlayRelaySession(
                'a' * 32,
                requested_profile=expected_profile,
                relay_mode='b1',
                tv_open_callback=lambda **kw: events.append(('open', kw, session.lock._is_owned())),
                tv_teardown_callback=lambda **kw: events.append(('teardown', kw, session.lock._is_owned())),
            )
            detected = session.ingest_init(*init_bytes_level(level_idc))
            self.assertEqual(detected.name, expected_profile)
            session.ingest_fragment(*pair())
            self.assertEqual(
                events,
                [('open', {'epoch': 'a' * 32, 'codec': expected_codec, 'profile': expected_profile}, True)],
            )
            session.ingest_fragment(*pair(2, 16000, 12288, sync=False))
            self.assertEqual(len(events), 1)
            snap = session.close('sender-disconnected')
            self.assertTrue(snap['closed'])
            self.assertEqual(snap['closeReason'], 'sender-disconnected')
            self.assertEqual(
                events[1],
                ('teardown', {'epoch': 'a' * 32, 'reason': 'sender-disconnected'}, True),
            )
            session.close('teardown')
            self.assertEqual(len(events), 2)

    def test_run_relay_writes_sdp_pumps_fmp4_and_tears_down(self):
        import io
        import types
        stream_bytes = b''.join(init_bytes_level(156)) + b''.join(pair())
        spawned = []
        terminated = []
        events = []

        def fake_spawn(argv, **kwargs):
            stdin_buf = io.BytesIO()
            stdin_buf.close = lambda: setattr(stdin_buf, 'closed_flag', True)
            if argv == ['uxplay', '-v']:
                stdout_buf = io.BytesIO(b'UxPlay version 1.73.7; for help, use option "-h"\n')
            elif argv[0] == 'ffmpeg':
                stdout_buf = io.BytesIO(stream_bytes)
            else:
                stdout_buf = None
            proc = types.SimpleNamespace(argv=argv, stdin=stdin_buf, stdout=stdout_buf)
            spawned.append(proc)
            return proc

        session = ap.AirPlayRelaySession(
            'b' * 32,
            requested_profile='4k120_hevc',
            relay_mode='b1',
            tv_open_callback=lambda **kw: events.append(('open', kw)),
            tv_teardown_callback=lambda **kw: events.append(('teardown', kw)),
        )
        snap = session.run_relay(fake_spawn, terminate=lambda p: terminated.append(p.argv[0]))
        self.assertEqual([p.argv[0] for p in spawned], ['uxplay', 'ffmpeg', 'uxplay'])
        self.assertEqual(spawned[0].argv, ['uxplay', '-v'])
        self.assertIn(b'H265/90000', spawned[1].stdin.getvalue())
        self.assertIn(b'L16/44100/2', spawned[1].stdin.getvalue())
        self.assertTrue(getattr(spawned[1].stdin, 'closed_flag', False))
        self.assertEqual(snap['activeProfile'], '4k120_hevc')
        self.assertTrue(snap['tvOpened'])
        self.assertTrue(snap['closed'])
        self.assertEqual([e[0] for e in events], ['open', 'teardown'])
        self.assertEqual(terminated, ['uxplay', 'ffmpeg'])

        # Delayed first RTP (e.g., slow receiver selection / PIN entry): FFmpeg retries without killing UxPlay
        slow_spawned = []
        ffmpeg_calls = []
        def slow_spawn(argv, **kwargs):
            stdin_buf = io.BytesIO()
            if argv == ['uxplay', '-v']:
                stdout_buf = io.BytesIO(b'UxPlay version 1.73.7; for help, use option "-h"\n')
            elif argv[0] == 'ffmpeg':
                ffmpeg_calls.append(len(ffmpeg_calls))
                stdout_buf = io.BytesIO(b'' if len(ffmpeg_calls) < 3 else stream_bytes)
            else:
                stdout_buf = None
            proc = types.SimpleNamespace(argv=argv, stdin=stdin_buf, stdout=stdout_buf, poll=lambda: None)
            slow_spawned.append(proc)
            return proc

        slow_session = ap.AirPlayRelaySession('f' * 32, requested_profile='4k120_hevc', relay_mode='b1')
        slow_snap = slow_session.run_relay(slow_spawn, max_startup_attempts=4)
        self.assertEqual([p.argv[0] for p in slow_spawned], ['uxplay', 'ffmpeg', 'uxplay', 'ffmpeg', 'ffmpeg'])
        self.assertEqual(slow_snap['activeProfile'], '4k120_hevc')
        self.assertTrue(slow_snap['tvOpened'])
        self.assertEqual(slow_snap['closeReason'], 'sender-disconnected')

        # Exhausted startup attempts with zero RTP must raise AIRPLAY_STARTUP_TIMEOUT and close with 'error'
        never_session = ap.AirPlayRelaySession('9' * 32, requested_profile='4k60_hevc', relay_mode='b1')
        def empty_spawn(argv, **kwargs):
            return types.SimpleNamespace(
                argv=argv,
                stdin=io.BytesIO(),
                stdout=io.BytesIO(b'UxPlay version 1.73.7\n' if argv == ['uxplay', '-v'] else b''),
                poll=lambda: None,
            )
        with self.assertRaisesRegex(RuntimeError, 'AIRPLAY_STARTUP_TIMEOUT'):
            never_session.run_relay(empty_spawn, max_startup_attempts=2)
        self.assertTrue(never_session.closed)
        self.assertEqual(never_session.close_reason, 'error')

        # Vulnerable UxPlay (< 1.73.7) must be refused before spawning ffmpeg or listener
        old_calls = []
        def old_spawn(argv, **kwargs):
            old_calls.append(argv)
            return types.SimpleNamespace(
                argv=argv,
                stdout=io.BytesIO(b'UxPlay version 1.73.6; for help, use option "-h"\n'),
                stderr=None,
            )

        bad_session = ap.AirPlayRelaySession('e' * 32)
        with self.assertRaisesRegex(ValueError, 'UXPLAY_VERSION_TOO_OLD'):
            bad_session.run_relay(old_spawn)
        self.assertEqual(old_calls, [['uxplay', '-v']])
        self.assertTrue(bad_session.closed)
        self.assertEqual(bad_session.close_reason, 'error')

    def test_close_during_idle_relay_terminates_processes_and_unblocks_reader(self):
        import io
        import threading
        import types

        read_entered = threading.Event()
        stdout_closed = threading.Event()
        terminated = []

        class BlockingStdout:
            def read(self, count):
                read_entered.set()
                stdout_closed.wait(2)
                return b''

            def close(self):
                stdout_closed.set()

        def fake_spawn(argv, **kwargs):
            stdin_buf = io.BytesIO()
            if argv == ['uxplay', '-v']:
                stdout_buf = io.BytesIO(b'UxPlay 1.73.7\n')
            elif argv[0] == 'ffmpeg':
                stdout_buf = BlockingStdout()
            else:
                stdout_buf = None
            return types.SimpleNamespace(argv=argv, stdin=stdin_buf, stdout=stdout_buf)

        session = ap.AirPlayRelaySession('c' * 32, requested_profile='4k60_hevc', relay_mode='b1')
        relay_out = []
        t = threading.Thread(
            target=lambda: relay_out.append(
                session.run_relay(fake_spawn, terminate=lambda p: terminated.append(p.argv[0]))
            )
        )
        t.start()
        self.assertTrue(read_entered.wait(1))
        snap = session.close('owner-ended')
        t.join(1)
        self.assertFalse(t.is_alive())
        self.assertTrue(snap['closed'])
        self.assertEqual(snap['closeReason'], 'owner-ended')
        self.assertEqual(terminated, ['uxplay', 'ffmpeg'])
        self.assertEqual(relay_out[0]['closeReason'], 'owner-ended')

        # Even if tv_teardown_callback raises, _stop_processes() must still run in finally:
        read_entered2 = threading.Event()
        stdout_closed2 = threading.Event()
        terminated2 = []

        class BlockingStdout2:
            def read(self, count):
                read_entered2.set()
                stdout_closed2.wait(2)
                return b''

            def close(self):
                stdout_closed2.set()

        def fake_spawn2(argv, **kwargs):
            stdin_buf = io.BytesIO()
            if argv == ['uxplay', '-v']:
                stdout_buf = io.BytesIO(b'UxPlay 1.73.7\n')
            elif argv[0] == 'ffmpeg':
                stdout_buf = BlockingStdout2()
            else:
                stdout_buf = None
            return types.SimpleNamespace(argv=argv, stdin=stdin_buf, stdout=stdout_buf)

        def broken_teardown(**kw):
            raise RuntimeError('synthetic TV teardown error')

        session2 = ap.AirPlayRelaySession(
            'd' * 32,
            requested_profile='4k60_hevc',
            relay_mode='b1',
            tv_teardown_callback=broken_teardown,
        )
        t2 = threading.Thread(
            target=lambda: session2.run_relay(fake_spawn2, terminate=lambda p: terminated2.append(p.argv[0]))
        )
        t2.start()
        self.assertTrue(read_entered2.wait(1))
        with self.assertRaises(RuntimeError):
            session2.close('owner-ended')
        t2.join(1)
        self.assertFalse(t2.is_alive())
        self.assertTrue(stdout_closed2.is_set())
        self.assertEqual(terminated2, ['uxplay', 'ffmpeg'])

        # Blocked version-probe pipe ('uxplay -v') must also be owned, cancelled by close(), and bounded by timeout
        probe_read_entered = threading.Event()
        probe_stdout_closed = threading.Event()
        probe_terminated = []
        probe_spawned = []

        class BlockingProbeStdout:
            def read(self, count):
                probe_read_entered.set()
                probe_stdout_closed.wait(2)
                return b''

            def close(self):
                probe_stdout_closed.set()

        def blocking_probe_spawn(argv, **kwargs):
            proc = types.SimpleNamespace(
                argv=argv,
                stdin=io.BytesIO(),
                stdout=BlockingProbeStdout(),
                stderr=io.BytesIO(b''),
            )
            probe_spawned.append(proc)
            return proc

        session3 = ap.AirPlayRelaySession('5' * 32, requested_profile='4k60_hevc', relay_mode='b1')
        relay_out3 = []
        t3 = threading.Thread(
            target=lambda: relay_out3.append(
                session3.run_relay(blocking_probe_spawn, terminate=lambda p: probe_terminated.append(p.argv))
            )
        )
        t3.start()
        self.assertTrue(probe_read_entered.wait(1))
        snap3 = session3.close('owner-ended')
        t3.join(1)
        self.assertFalse(t3.is_alive())
        self.assertTrue(probe_stdout_closed.is_set())
        self.assertEqual([p.argv for p in probe_spawned], [['uxplay', '-v']])
        self.assertEqual(probe_terminated, [['uxplay', '-v']])
        self.assertTrue(snap3['closed'])
        self.assertEqual(snap3['closeReason'], 'owner-ended')
        self.assertEqual(relay_out3[0]['closeReason'], 'owner-ended')

        # Uncancelled hung version probe must time out and reap the probe child
        hung_closed = threading.Event()
        hung_terminated = []

        class HungProbeStdout:
            def read(self, count):
                hung_closed.wait(2)
                return b''

            def close(self):
                hung_closed.set()

        session4 = ap.AirPlayRelaySession('4' * 32, requested_profile='4k60_hevc', relay_mode='b1')
        session4._terminate_fn = lambda p: hung_terminated.append(p.argv)
        with self.assertRaisesRegex(RuntimeError, 'UXPLAY_VERSION_PROBE_TIMEOUT'):
            session4._probe_uxplay_version(
                lambda argv, **kw: types.SimpleNamespace(
                    argv=argv,
                    stdout=HungProbeStdout(),
                    stderr=io.BytesIO(b''),
                ),
                timeout_s=0.08,
            )
        self.assertTrue(hung_closed.is_set())
        self.assertEqual(hung_terminated, [['uxplay', '-v']])

        # Real subprocess probe where a forked descendant keeps stdout/stderr open must bound timeout and close()
        import os
        import signal
        import subprocess
        import sys
        import time

        fork_children = []
        fork_code = 'import os, time; os.fork(); time.sleep(30)'
        def fork_spawn(argv, **kwargs):
            proc = subprocess.Popen([sys.executable, '-u', '-c', fork_code], start_new_session=True, **kwargs)
            fork_children.append(proc)
            return proc

        try:
            session5 = ap.AirPlayRelaySession('3' * 32, requested_profile='4k60_hevc', relay_mode='b1')
            t0 = time.monotonic()
            with self.assertRaisesRegex(RuntimeError, 'UXPLAY_VERSION_PROBE_TIMEOUT'):
                session5._probe_uxplay_version(fork_spawn, timeout_s=0.12)
            self.assertLess(time.monotonic() - t0, 0.8)
            self.assertIsNotNone(fork_children[0].poll())

            session6 = ap.AirPlayRelaySession('2' * 32, requested_profile='4k60_hevc', relay_mode='b1')
            relay_out6 = []
            t6 = threading.Thread(target=lambda: relay_out6.append(session6.run_relay(fork_spawn)))
            t6.start()
            deadline6 = time.monotonic() + 1.0
            while len(fork_children) < 2 and time.monotonic() < deadline6:
                time.sleep(0.01)
            self.assertEqual(len(fork_children), 2)
            t_close = time.monotonic()
            snap6 = session6.close('owner-ended')
            t6.join(0.8)
            self.assertLess(time.monotonic() - t_close, 0.8)
            self.assertFalse(t6.is_alive())
            self.assertEqual(snap6['closeReason'], 'owner-ended')
            self.assertEqual(relay_out6[0]['closeReason'], 'owner-ended')
        finally:
            for proc in fork_children:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                try:
                    proc.wait(timeout=2)
                except Exception:
                    pass

        # Verify close() between poll() and os.read() never reads from a reused descriptor
        from unittest.mock import patch
        polled_evt = threading.Event()
        resume_poll_evt = threading.Event()
        target_fds = []
        race_children = []
        padding_fds = []
        replacement_pipe = None
        real_poll_cls = ap.select.poll

        class PausingPoller:
            def __init__(self):
                self._inner = real_poll_cls()
            def register(self, fd, mask):
                return self._inner.register(fd, mask)
            def unregister(self, fd):
                return self._inner.unregister(fd)
            def poll(self, timeout=None):
                events = self._inner.poll(timeout)
                if target_fds and any(fd == target_fds[0] for fd, _ in events):
                    polled_evt.set()
                    resume_poll_evt.wait(2)
                return events

        def race_spawn(argv, **kwargs):
            proc = subprocess.Popen(
                [sys.executable, '-B', '-u', '-c', 'import time; print("UxPlay 1.73.7"); time.sleep(30)'],
                **kwargs,
            )
            race_children.append(proc)
            target_fds.append(proc.stdout.fileno())
            return proc

        session7 = ap.AirPlayRelaySession('1' * 32, requested_profile='4k60_hevc', relay_mode='b1')
        relay_out7 = []
        try:
            with patch.object(ap.select, 'poll', PausingPoller):
                t7 = threading.Thread(target=lambda: relay_out7.append(session7.run_relay(race_spawn)))
                t7.start()
                self.assertTrue(polled_evt.wait(2))
                session7.close('owner-ended')
                while True:
                    fd = os.open(os.devnull, os.O_RDONLY)
                    if fd == target_fds[0]:
                        os.close(fd)
                        break
                    padding_fds.append(fd)
                replacement_pipe = os.pipe()
                self.assertEqual(replacement_pipe[0], target_fds[0])
                os.write(replacement_pipe[1], b'unrelated-data')
                resume_poll_evt.set()
                t7.join(0.8)
                self.assertFalse(t7.is_alive())
                os.set_blocking(replacement_pipe[0], False)
                self.assertEqual(os.read(replacement_pipe[0], 64), b'unrelated-data')
                self.assertEqual(relay_out7[0]['closeReason'], 'owner-ended')
        finally:
            resume_poll_evt.set()
            for proc in race_children:
                if proc.poll() is None:
                    proc.kill()
                proc.wait(timeout=2)
            for fd in padding_fds + list(replacement_pipe or ()):
                try:
                    os.close(fd)
                except OSError:
                    pass

        # Verify version probe works with descriptors above select()'s 1024 FD_SETSIZE limit
        high_fds = []
        high_children = []
        try:
            try:
                for _ in range(1050):
                    high_fds.append(os.open(os.devnull, os.O_RDONLY))
            except OSError:
                pass
            if high_fds and max(high_fds) >= 1024:
                def high_fd_spawn(argv, **kwargs):
                    proc = subprocess.Popen(
                        [sys.executable, '-B', '-u', '-c', 'print("UxPlay 1.74.0")'],
                        **kwargs,
                    )
                    high_children.append(proc)
                    return proc
                session8 = ap.AirPlayRelaySession('6' * 32)
                self.assertEqual(session8._probe_uxplay_version(high_fd_spawn), (1, 74, 0))
        finally:
            for proc in high_children:
                proc.wait(timeout=2)
            for fd in high_fds:
                try:
                    os.close(fd)
                except OSError:
                    pass

    def test_process_reap_wait_and_kill_fallback_and_stdio_isolation(self):
        import io
        import subprocess
        import tempfile
        import types
        from pathlib import Path
        from unittest.mock import patch

        synthetic_id = ':'.join(('11', '22', '33', '44', '55', '66'))
        session = ap.AirPlayRelaySession(
            '8' * 32,
            uxplay_bin='/opt/local/bin/uxplay',
            requested_profile='4k60_hevc',
            relay_mode='b2',
            password='private-password',
            device_id=synthetic_id,
            fps_data=True,
            listen_timeout_s=20,
        )
        self.assertEqual(session.uxplay_command[0], '/opt/local/bin/uxplay')
        self.assertIn('-FPSdata', session.uxplay_command)
        self.assertIn('private-password', session.uxplay_command)
        self.assertIn(synthetic_id, session.uxplay_command)
        self.assertIn('20', session.ffmpeg_command)

        # Verify _reap_process calls terminate -> wait(timeout=2) -> kill() -> wait(timeout=1) when wait times out
        actions = []
        class StubbornProc:
            def __init__(self):
                self.stdin = io.BytesIO()
                self.stdout = io.BytesIO()
                self.stderr = io.BytesIO()
                self.waits = 0
            def poll(self):
                return None
            def terminate(self):
                actions.append('terminate')
            def wait(self, timeout=None):
                self.waits += 1
                actions.append(('wait', timeout))
                if self.waits == 1:
                    raise subprocess.TimeoutExpired('uxplay', timeout)
                return -9
            def kill(self):
                actions.append('kill')

        stubborn = StubbornProc()
        ap.AirPlayRelaySession._reap_process(stubborn)
        self.assertEqual(actions, ['terminate', ('wait', 2), 'kill', ('wait', 1)])
        self.assertTrue(stubborn.stdin.closed)
        self.assertTrue(stubborn.stdout.closed)
        self.assertTrue(stubborn.stderr.closed)

        # Verify DEVNULL stdio isolation and early exit when uxplay dies on attempt 0
        seen_kwargs = []
        def dead_uxplay_spawn(argv, **kwargs):
            seen_kwargs.append((argv[0], kwargs))
            if argv[-1] == '-v':
                return types.SimpleNamespace(
                    argv=argv,
                    stdout=io.BytesIO(b'UxPlay version 1.74\n'),
                    stderr=io.BytesIO(b''),
                    wait=lambda timeout=None: 0,
                )
            if argv[0] == 'ffmpeg':
                return types.SimpleNamespace(
                    argv=argv,
                    stdin=io.BytesIO(),
                    stdout=io.BytesIO(b''),
                    poll=lambda: 0,
                    wait=lambda timeout=None: 0,
                )
            return types.SimpleNamespace(
                argv=argv,
                poll=lambda: 1,
                terminate=lambda: None,
                wait=lambda timeout=None: 1,
            )

        early_session = ap.AirPlayRelaySession('7' * 32)
        with self.assertRaisesRegex(RuntimeError, 'AIRPLAY_STARTUP_TIMEOUT'):
            early_session.run_relay(dead_uxplay_spawn, max_startup_attempts=5)
        # Should stop immediately after attempt 0 because uxplay_proc.poll() returned 1
        self.assertEqual([name for name, _ in seen_kwargs], ['uxplay', 'ffmpeg', 'uxplay'])
        self.assertIs(seen_kwargs[1][1].get('stderr'), subprocess.DEVNULL)
        self.assertIs(seen_kwargs[2][1].get('stdin'), subprocess.DEVNULL)
        self.assertIs(seen_kwargs[2][1].get('stdout'), subprocess.DEVNULL)
        self.assertIs(seen_kwargs[2][1].get('stderr'), subprocess.DEVNULL)

        # Verify _default_relay_env prepends ~/.local/bin and ~/.local/lib when present
        with tempfile.TemporaryDirectory() as td:
            fake_home = Path(td)
            (fake_home / '.local/bin').mkdir(parents=True)
            (fake_home / '.local/lib').mkdir(parents=True)
            with patch.object(ap.Path, 'home', return_value=fake_home), patch.dict(
                ap.os.environ, {'PATH': '/usr/bin:/bin', 'LD_LIBRARY_PATH': '/usr/lib'}, clear=False
            ):
                env = ap._default_relay_env()
                self.assertTrue(env['PATH'].startswith(str(fake_home / '.local/bin') + ap.os.pathsep))
                self.assertTrue(env['LD_LIBRARY_PATH'].startswith(str(fake_home / '.local/lib') + ap.os.pathsep))

